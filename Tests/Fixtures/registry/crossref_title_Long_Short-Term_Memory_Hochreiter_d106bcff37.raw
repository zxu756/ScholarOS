OU-214"],"award-info":[{"award-number":["LIT-2018-6-YOU-214"]}],"id":[{"id":"10.13039\/501100013699","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100013699","name":"Bundesministerium f\u00fcr Bildung, Wissenschaft und Forschung","doi-asserted-by":"publisher","award":["LIT-2019-8-YOU-213"],"award-info":[{"award-number":["LIT-2019-8-YOU-213"]}],"id":[{"id":"10.13039\/501100013699","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100004955","name":"\u00d6sterreichische Forschungsf\u00f6rderungsgesellschaft","doi-asserted-by":"publisher","award":["FFG-873979"],"award-info":[{"award-number":["FFG-873979"]}],"id":[{"id":"10.13039\/501100004955","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100004955","name":"\u00d6sterreichische Forschungsf\u00f6rderungsgesellschaft","doi-asserted-by":"publisher","award":["FFG-872172"],"award-info":[{"award-number":["FFG-872172"]}],"id":[{"id":"10.13039\/501100004955","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100004955","name":"\u00d6sterreichische Forschungsf\u00f6rderungsgesellschaft","doi-asserted-by":"publisher","award":["FFG-871302"],"award-info":[{"award-number":["FFG-871302"]}],"id":[{"id":"10.13039\/501100004955","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/100010661","name":"Horizon 2020 Framework Programme","doi-asserted-by":"publisher","id":[{"id":"10.13039\/100010661","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/100008897","name":"Janssen Pharmaceutica","doi-asserted-by":"publisher","award":["N\/A"],"award-info":[{"award-number":["N\/A"]}],"id":[{"id":"10.13039\/100008897","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/100006785","name":"Google","doi-asserted-by":"publisher","award":["N\/A"],"award-info":[{"award-number":["N\/A"]}],"id":[{"id":"10.13039\/100006785","id-type":"DOI","asserted-by":"publisher"}]}],"content-domain":{"domain":[],"crossmark-restriction":false},"abstract":"<jats:p>Abstract. Long Short-Term Memory Networks (LSTMs) have been applied to daily discharge prediction with remarkable success. Many practical scenarios, however, require predictions at more granular timescales. For instance, accurate prediction of short but extreme flood peaks can make a life-saving difference, yet such peaks may escape the coarse temporal resolution of daily predictions. Naively training an LSTM on hourly data, however, entails very long input sequences that make learning hard and computationally expensive. In this study, we propose two Multi-Timescale LSTM (MTS-LSTM) architectures that jointly predict multiple timescales within one model, as they process long-past inputs at a single temporal resolution and branch out into each individual timescale for more recent input steps. We test these models on 516 basins across the continental United States and benchmark against the US National Water Model. Compared to naive prediction with a distinct LSTM per timescale, the multi-timescale architectures are computationally more efficient with no loss in accuracy. Beyond prediction quality, the multi-timescale LSTM can process different input variables at different timescales, which is especially relevant to operational applications where the lead time of meteorological forcings depends on their temporal resolution.<\/jats:p>","DOI":"10.5194\/hess-2020-540","type":"posted-content","created":{"date-parts":[[2020,11,17]],"date-time":"2020-11-17T08:42:16Z","timestamp":1605602536000},"source":"Crossref","is-referenced-by-count":8,"title":["Rainfall\u2013Runoff Prediction at Multiple Timescales with a Single\nLong Short-Term Memory Network"],"prefix":"10.5194","author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-4587-898X","authenticated-orcid":false,"given":"Martin","family":"Gauch","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-8897-7689","authenticated-orcid":false,"given":"Frederik","family":"Kratzert","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-9843-6798","authenticated-orcid":false,"given":"Daniel","family":"Klotz","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-7031-6770","authenticated-orcid":false,"given":"Grey","family":"Nearing","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jimmy","family":"Lin","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Sepp","family":"Hochreiter","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"3145","deposited":{"date-parts":[[2025,1,31]],"date-time":"2025-01-31T08:34:45Z","timestamp":1738312485000},"score":34.399025,"resource":{"primary":{"URL":"https:\/\/hess.copernicus.org\/articles\/25\/2045\/2021\/hess-25-2045-2021-discussion.html"}},"issued":{"date-parts":[[2020,11,17]]},"references-count":0,"URL":"https:\/\/doi.org\/10.5194\/hess-2020-540","relation":{"has-comment":[{"id-type":"doi","id":"10.5194\/hess-2020-540-AC2","asserted-by":"subject"},{"id-type":"doi","id":"10.5194\/hess-2020-540-AC1","asserted-by":"subject"}],"has-review":[{"id-type":"doi","id":"10.5194\/hess-2020-540-RC1","asserted-by":"subject"},{"id-type":"doi","id":"10.5194\/hess-2020-540-RC2","asserted-by":"subject"}],"is-part-of":[{"id-type":"doi","id":"10.5281\/zenodo.4071885","asserted-by":"subject"},{"id-type":"doi","id":"10.5281\/zenodo.4072700","asserted-by":"subject"}],"is-preprint-of":[{"id-type":"doi","id":"10.5194\/hess-25-2045-2021","asserted-by":"subject"},{"id-type":"doi","id":"10.5194\/hess-25-2045-2021","asserted-by":"object"}],"is-referenced-by":[{"id-type":"doi","id":"10.1038\/s41598-026-44754-4","asserted-by":"object"}]},"published":{"date-parts":[[2020,11,17]]},"subtype":"preprint"},{"indexed":{"date-parts":[[2026,9,17]],"date-time":"2026-09-17T07:07:32Z","timestamp":1789628852583,"version":"build-2803163510"},"posted":{"date-parts":[[2019,8,2]]},"group-title":"Global hydrology\/Modelling approaches","reference-count":0,"publisher":"Copernicus GmbH","license":[{"start":{"date-parts":[[2019,8,2]],"date-time":"2019-08-02T00:00:00Z","timestamp":1564704000000},"content-version":"vor","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0\/"}],"content-domain":{"domain":[],"crossmark-restriction":false},"abstract":"<jats:p>Abstract. Regional rainfall-runoff modeling is an old but still mostly out-standing problem in Hydrological Sciences. The problem currently is that traditional hydrological models degrade significantly in performance when calibrated for multiple basins together instead of for a single basin alone. In this paper, we propose a novel, data-driven approach using Long Short-Term Memory networks (LSTMs), and demonstrate that under a big data paradigm, this is not necessarily the case. By training a single LSTM model on 531 basins from the CAMELS data set using meteorological time series data and static catchment attributes, we were able to significantly improve performance compared to a set of several different hydrological benchmark models. Our proposed approach not only significantly outperforms hydrological models that were calibrated regionally but also achieves better performance than hydrological models that were calibrated for each basin individually. Furthermore, we propose an adaption to the standard LSTM architecture, which we call an Entity-Aware-LSTM (EA-LSTM), that allows for learning, and embedding as a feature layer in a deep learning model, catchment similarities. We show that this learned catchment similarity corresponds well with what we would expect from prior hydrological understanding.<\/jats:p>","DOI":"10.5194\/hess-2019-368","type":"posted-content","created":{"date-parts":[[2019,8,2]],"date-time":"2019-08-02T07:58:10Z","timestamp":1564732690000},"source":"Crossref","is-referenced-by-count":25,"title":["Benchmarking a Catchment-Aware Long Short-Term Memory\nNetwork (LSTM) for Large-Scale Hydrological Modeling"],"prefix":"10.5194","author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-8897-7689","authenticated-orcid":false,"given":"Frederik","family":"Kratzert","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-9843-6798","authenticated-orcid":false,"given":"Daniel","family":"Klotz","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Guy","family":"Shalev","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"G\u00fcnter","family":"Klambauer","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Sepp","family":"Hochreiter","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-7031-6770","authenticated-orcid":false,"given":"Grey","family":"Nearing","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"3145","link":[{"URL":"https:\/\/www.hydrol-earth-syst-sci-discuss.net\/hess-2019-368\/hess-2019-368.pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2025,2,1]],"date-time":"2025-02-01T00:04:44Z","timestamp":1738368284000},"score":34.29307,"resource":{"primary":{"URL":"https:\/\/hess.copernicus.org\/articles\/23\/5089\/2019\/hess-23-5089-2019-discussion.html"}},"issued":{"date-parts":[[2019,8,2]]},"references-count":0,"URL":"https:\/\/doi.org\/10.5194\/hess-2019-368","relation":{"has-comment":[{"id-type":"doi","id":"10.5194\/hess-2019-368-AC1","asserted-by":"subject"},{"id-type":"doi","id":"10.5194\/hess-2019-368-AC3","asserted-by":"subject"},{"id-type":"doi","id":"10.5194\/hess-2019-368-AC2","asserted-by":"subject"}],"has-review":[{"id-type":"doi","id":"10.5194\/hess-2019-368-RC1","asserted-by":"subject"},{"id-type":"doi","id":"10.5194\/hess-2019-368-RC2","asserted-by":"subject"},{"id-type":"doi","id":"10.5194\/hess-2019-368-RC3","asserted-by":"subject"},{"id-type":"doi","id":"10.5194\/hess-2019-368-RC4","asserted-by":"subject"}],"is-preprint-of":[{"id-type":"doi","id":"10.5194\/hess-23-5089-2019","asserted-by":"subject"},{"id-type":"doi","id":"10.5194\/hess-23-5089-2019","asserted-by":"object"}]},"published":{"date-parts":[[2019,8,2]]},"subtype":"preprint"}],"items-per-page":5,"query":{"start-index":0,"search-terms":null}}}