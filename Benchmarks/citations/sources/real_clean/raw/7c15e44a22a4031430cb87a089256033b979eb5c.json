0456\\u0434\\u043d\\u043e\\u0441\\u0438\\u043d\\u0438 \\u0437 \\u0412\\u0435\\u043b\\u0438\\u043a\\u043e\\u044e \\u0411\\u0440\\u0438\\u0442\\u0430\\u043d\\u0456\\u0454\\u044e, \\u0421\\u0428\\u0410, \\u041a\\u0430\\u043d\\u0430\\u0434\\u043e\\u044e, \\u0410\\u0432\\u0441\\u0442\\u0440\\u0430\\u043b\\u0456\\u0454\\u044e \\u0442\\u0430 \\u0404\\u0421, \\u0434\\u0435 \\u043f\\u0440\\u043e\\u0436\\u0438\\u0432\\u0430\\u0454 \\u043d\\u0430\\u0439\\u0431\\u0456\\u043b\\u044c\\u0448\\u0430 \\u043a\\u0456\\u043b\\u044c\\u043a\\u0456\\u0441\\u0442\\u044c \\u0432\\u0438\\u0445\\u0456\\u0434\\u0446\\u0456\\u0432 \\u0437 \\u0406\\u0440\\u043b\\u0430\\u043d\\u0434\\u0456\\u0457, \\u0432\\u0438\\u0437\\u043d\\u0430\\u0447\\u0438\\u043b\\u0438 \\u0456\\u043c\\u043c\\u0456\\u0433\\u0440\\u0430\\u0446\\u0456\\u0439\\u043d\\u0443 \\u043f\\u043e\\u043b\\u0456\\u0442\\u0438\\u043a\\u0443 \\u0420\\u0435\\u0441\\u043f\\u0443\\u0431\\u043b\\u0456\\u043a\\u0438 \\u0406\\u0440\\u043b\\u0430\\u043d\\u0434\\u0456\\u044f, \\u0449\\u043e \\u0437\\u043e\\u0441\\u0435\\u0440\\u0435\\u0434\\u0436\\u0435\\u043d\\u0430 \\u043d\\u0430 \\u043f\\u0438\\u0442\\u0430\\u043d\\u043d\\u044f\\u0445 \\u0456\\u043d\\u0442\\u0435\\u0433\\u0440\\u0430\\u0446\\u0456\\u0457 \\u0442\\u0430 \\u043d\\u0430\\u0434\\u0430\\u043d\\u043d\\u044f \\u043f\\u0440\\u0438\\u0442\\u0443\\u043b\\u043a\\u0443 \\u0432\\u0441\\u0456\\u043c \\u0433\\u0440\\u043e\\u043c\\u0430\\u0434\\u044f\\u043d\\u0430\\u043c, \\u044f\\u043a\\u0456 \\u043c\\u0430\\u044e\\u0442\\u044c \\u0456\\u0440\\u043b\\u0430\\u043d\\u0434\\u0441\\u044c\\u043a\\u0435 \\u043a\\u043e\\u0440\\u0456\\u043d\\u043d\\u044f. \\u041d\\u0435\\u0437\\u0432\\u0430\\u0436\\u0430\\u044e\\u0447\\u0438 \\u043d\\u0430 \\u0434\\u0435\\u044f\\u043a\\u0456 \\u043f\\u043e\\u0431\\u043e\\u044e\\u0432\\u0430\\u043d\\u043d\\u044f, \\u0441\\u0442\\u0430\\u0432\\u043b\\u0435\\u043d\\u043d\\u044f \\u0456\\u0440\\u043b\\u0430\\u043d\\u0434\\u0446\\u0456\\u0432 \\u0434\\u043e \\u0456\\u043c\\u043c\\u0456\\u0433\\u0440\\u0430\\u0446\\u0456\\u0457 \\u0437\\u0430\\u0433\\u0430\\u043b\\u043e\\u043c \\u0437\\u0430\\u043b\\u0438\\u0448\\u0430\\u0454\\u0442\\u044c\\u0441\\u044f \\u043f\\u043e\\u0437\\u0438\\u0442\\u0438\\u0432\\u043d\\u0438\\u043c. \\u0412\\u0438\\u044f\\u0432\\u043b\\u0435\\u043d\\u043e, \\u0449\\u043e \\u043d\\u0430 \\u043f\\u043e\\u0447\\u0430\\u0442\\u043a\\u0443 1990\\u2013\\u0445 \\u0440\\u0440. \\u0443 \\u0420\\u0435\\u0441\\u043f\\u0443\\u0431\\u043b\\u0456\\u0446\\u0456 \\u0406\\u0440\\u043b\\u0430\\u043d\\u0434\\u0456\\u044f \\u0440\\u043e\\u0437\\u043f\\u043e\\u0447\\u0438\\u043d\\u0430\\u0454\\u0442\\u044c\\u0441\\u044f \\u0435\\u043f\\u043e\\u0445\\u0430 \\u0456\\u043c\\u043c\\u0456\\u0433\\u0440\\u0430\\u0446\\u0456\\u0457, \\u0449\\u043e \\u043f\\u043e\\u0432\\u2019\\u044f\\u0437\\u0430\\u043d\\u0430 \\u044f\\u043a \\u0456\\u0437 \\u043f\\u043e\\u0432\\u0435\\u0440\\u043d\\u0435\\u043d\\u043d\\u044f\\u043c \\u0447\\u0430\\u0441\\u0442\\u0438\\u043d\\u0438 \\u0447\\u0438\\u0441\\u043b\\u0435\\u043d\\u043d\\u043e\\u0457 \\u0434\\u0456\\u0430\\u0441\\u043f\\u043e\\u0440\\u0438 \\u0456\\u0440\\u043b\\u0430\\u043d\\u0434\\u0441\\u044c\\u043a\\u043e\\u0457 \\u0434\\u0435\\u0440\\u0436\\u0430\\u0432\\u0438, \\u0442\\u0430\\u043a \\u0456 \\u0437 \\u043f\\u0435\\u0440\\u0456\\u043e\\u0434\\u043e\\u043c \\u0448\\u0432\\u0438\\u0434\\u043a\\u043e\\u0433\\u043e \\u0435\\u043a\\u043e\\u043d\\u043e\\u043c\\u0456\\u0447\\u043d\\u043e\\u0433\\u043e \\u0437\\u0440\\u043e\\u0441\\u0442\\u0430\\u043d\\u043d\\u044f \\u043a\\u0440\\u0430\\u0457\\u043d\\u0438 \\u2013 \\u043f\\u0435\\u0440\\u0435\\u0442\\u0432\\u043e\\u0440\\u0435\\u043d\\u043d\\u044f \\u0420\\u0435\\u0441\\u043f\\u0443\\u0431\\u043b\\u0456\\u043a\\u0438 \\u0406\\u0440\\u043b\\u0430\\u043d\\u0434\\u0456\\u044f \\u043d\\u0430 \\u00ab\\u041a\\u0435\\u043b\\u044c\\u0442\\u0441\\u044c\\u043a\\u043e\\u0433\\u043e \\u0442\\u0438\\u0433\\u0440\\u0430\\u00bb \\u0430\\u0436 \\u0434\\u043e \\u0433\\u043b\\u043e\\u0431\\u0430\\u043b\\u044c\\u043d\\u043e\\u0457 \\u0444\\u0456\\u043d\\u0430\\u043d\\u0441\\u043e\\u0432\\u043e-\\u0435\\u043a\\u043e\\u043d\\u043e\\u043c\\u0456\\u0447\\u043d\\u043e\\u0457 \\u043a\\u0440\\u0438\\u0437\\u0438 2008 \\u0440., \\u0449\\u043e \\u0441\\u0435\\u0440\\u0439\\u043e\\u0437\\u043d\\u043e \\u0437\\u0430\\u0447\\u0435\\u043f\\u0438\\u043b\\u0430 \\u0456\\u0440\\u043b\\u0430\\u043d\\u0434\\u0441\\u044c\\u043a\\u0443 \\u0434\\u0435\\u0440\\u0436\\u0430\\u0432\\u0443. \\u0411\\u0430\\u0433\\u0430\\u0442\\u043e \\u0447\\u043b\\u0435\\u043d\\u0456\\u0432 \\u0456\\u0440\\u043b\\u0430\\u043d\\u0434\\u0441\\u044c\\u043a\\u043e\\u0457 \\u0434\\u0456\\u0430\\u0441\\u043f\\u043e\\u0440\\u0438 \\u043f\\u043e \\u0432\\u0441\\u044c\\u043e\\u043c\\u0443 \\u0441\\u0432\\u0456\\u0442\\u0443 \\u043f\\u043e\\u0432\\u0435\\u0440\\u0442\\u0430\\u044e\\u0442\\u044c\\u0441\\u044f, \\u0434\\u043e \\u043d\\u0438\\u0445 \\u043f\\u0440\\u0438\\u0454\\u0434\\u043d\\u0443\\u044e\\u0442\\u044c\\u0441\\u044f \\u0456\\u043c\\u043c\\u0456\\u0433\\u0440\\u0430\\u043d\\u0442\\u0438, \\u043e\\u0441\\u043e\\u0431\\u043b\\u0438\\u0432\\u043e \\u0437 \\u0456\\u043d\\u0448\\u0438\\u0445 \\u043a\\u0440\\u0430\\u0457\\u043d \\u0404\\u0421. \\u0412\\u0456\\u0434\\u043d\\u043e\\u0441\\u0438\\u043d\\u0438 \\u0437\\u0456 \\u0421\\u043f\\u043e\\u043b\\u0443\\u0447\\u0435\\u043d\\u0438\\u043c \\u041a\\u043e\\u0440\\u043e\\u043b\\u0456\\u0432\\u0441\\u0442\\u0432\\u043e\\u043c \\u0442\\u0430 \\u0404\\u0421 \\u0441\\u0444\\u043e\\u0440\\u043c\\u0443\\u0432\\u0430\\u043b\\u0438 \\u0456\\u043c\\u043c\\u0456\\u0433\\u0440\\u0430\\u0446\\u0456\\u0439\\u043d\\u0443 \\u043f\\u043e\\u043b\\u0456\\u0442\\u0438\\u043a\\u0443 \\u0420\\u0435\\u0441\\u043f\\u0443\\u0431\\u043b\\u0456\\u043a\\u0438 \\u0406\\u0440\\u043b\\u0430\\u043d\\u0434\\u0456\\u044f. \\u0421\\u0443\\u0447\\u0430\\u0441\\u043d\\u0456 \\u043f\\u043e\\u043b\\u0456\\u0442\\u0438\\u0447\\u043d\\u0456 \\u0434\\u0438\\u0441\\u043a\\u0443\\u0441\\u0456\\u0457 \\u0432 \\u0420\\u0435\\u0441\\u043f\\u0443\\u0431\\u043b\\u0456\\u0446\\u0456 \\u0406\\u0440\\u043b\\u0430\\u043d\\u0434\\u0456\\u044f \\u0437\\u043e\\u0441\\u0435\\u0440\\u0435\\u0434\\u0436\\u0435\\u043d\\u0456 \\u043d\\u0430 \\u043f\\u0438\\u0442\\u0430\\u043d\\u043d\\u044f\\u0445, \\u043f\\u043e\\u0432\\u2019\\u044f\\u0437\\u0430\\u043d\\u0438\\u0445 \\u0437 \\u0456\\u043d\\u0442\\u0435\\u0433\\u0440\\u0430\\u0446\\u0456\\u0454\\u044e \\u0442\\u0430 \\u043f\\u0440\\u0438\\u0442\\u0443\\u043b\\u043a\\u043e\\u043c. \\u041d\\u0435\\u0437\\u0432\\u0430\\u0436\\u0430\\u044e\\u0447\\u0438 \\u043d\\u0430 \\u0434\\u0435\\u044f\\u043a\\u0456 \\u043f\\u043e\\u0431\\u043e\\u044e\\u0432\\u0430\\u043d\\u043d\\u044f, \\u0441\\u0442\\u0430\\u0432\\u043b\\u0435\\u043d\\u043d\\u044f \\u0456\\u0440\\u043b\\u0430\\u043d\\u0434\\u0446\\u0456\\u0432 \\u0434\\u043e \\u0456\\u043c\\u043c\\u0456\\u0433\\u0440\\u0430\\u0446\\u0456\\u0457 \\u0437\\u0430\\u043b\\u0438\\u0448\\u0430\\u0454\\u0442\\u044c\\u0441\\u044f \\u0437\\u0430\\u0433\\u0430\\u043b\\u043e\\u043c \\u043f\\u043e\\u0437\\u0438\\u0442\\u0438\\u0432\\u043d\\u0438\\u043c \\u0417\\u2019\\u044f\\u0441\\u043e\\u0432\\u0430\\u043d\\u043e, \\u0449\\u043e \\u043f\\u0440\\u043e\\u0442\\u044f\\u0433\\u043e\\u043c \\u043e\\u0441\\u0442\\u0430\\u043d\\u043d\\u0456\\u0445 \\u043f\\u2019\\u044f\\u0442\\u0438 \\u0440\\u043e\\u043a\\u0456\\u0432 \\u0431\\u043b\\u0438\\u0437\\u044c\\u043a\\u043e 100 \\u0442\\u0438\\u0441. \\u0456\\u0440\\u043b\\u0430\\u043d\\u0434\\u0446\\u0456\\u0432 \\u043f\\u043e\\u0432\\u0435\\u0440\\u0442\\u0430\\u044e\\u0442\\u044c\\u0441\\u044f \\u043d\\u0430 \\u0431\\u0430\\u0442\\u044c\\u043a\\u0456\\u0432\\u0449\\u0438\\u043d\\u0443 \\u0437-\\u0437\\u0430 \\u043a\\u043e\\u0440\\u0434\\u043e\\u043d\\u0443 \\u043d\\u0430 \\u0440\\u0456\\u043a, \\u0449\\u043e \\u0454 \\u0431\\u0435\\u0437\\u043f\\u0440\\u0435\\u0446\\u0435\\u0434\\u0435\\u043d\\u0442\\u043d\\u0438\\u043c. \\u0411\\u0456\\u043b\\u044c\\u0448\\u0456\\u0441\\u0442\\u044c \\u0435\\u043c\\u0456\\u0433\\u0440\\u0430\\u043d\\u0442\\u0456\\u0432, \\u044f\\u043a\\u0456 \\u043f\\u043e\\u0432\\u0435\\u0440\\u0442\\u0430\\u044e\\u0442\\u044c\\u0441\\u044f, \\u2013 \\u0446\\u0435 \\u043b\\u044e\\u0434\\u0438 \\u0432\\u0456\\u043a\\u043e\\u043c \\u0432\\u0456\\u0434 30 \\u0434\\u043e 44 \\u0440\\u043e\\u043a\\u0456\\u0432, \\u044f\\u043a\\u0456 \\u043c\\u0430\\u044e\\u0442\\u044c \\u0434\\u0456\\u0442\\u0435\\u0439 \\u0442\\u0430 \\u043e\\u0441\\u0432\\u0456\\u0442\\u0443 \\u0432 \\u0456\\u0440\\u043b\\u0430\\u043d\\u0434\\u0441\\u044c\\u043a\\u0456\\u0439 \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c\\u0456 \\u043e\\u0441\\u0432\\u0456\\u0442\\u0438. \\u0414\\u043e\\u0432\\u0435\\u0434\\u0435\\u043d\\u043e, \\u0449\\u043e \\u0441\\u044c\\u043e\\u0433\\u043e\\u0434\\u043d\\u0456 \\u0456\\u043c\\u043c\\u0456\\u0433\\u0440\\u0430\\u043d\\u0442\\u0438 \\u0441\\u0442\\u0438\\u043a\\u0430\\u044e\\u0442\\u044c\\u0441\\u044f \\u0437 \\u0442\\u0440\\u0443\\u0434\\u043d\\u043e\\u0449\\u0430\\u043c\\u0438 \\u0432 \\u043f\\u043e\\u0448\\u0443\\u043a\\u0443 \\u0440\\u043e\\u0431\\u043e\\u0442\\u0438, \\u043e\\u0441\\u043e\\u0431\\u043b\\u0438\\u0432\\u043e \\u0432 \\u0414\\u0443\\u0431\\u043b\\u0456\\u043d\\u0456, \\u0437 \\u0432\\u0438\\u0437\\u043d\\u0430\\u043d\\u043d\\u044f\\u043c \\u0441\\u0432\\u043e\\u0457\\u0445 \\u043a\\u0432\\u0430\\u043b\\u0456\\u0444\\u0456\\u043a\\u0430\\u0446\\u0456\\u0439, \\u0437 \\u043f\\u043e\\u0448\\u0443\\u043a\\u043e\\u043c \\u0436\\u0438\\u0442\\u043b\\u0430, \\u0437 \\u0434\\u043e\\u0433\\u043b\\u044f\\u0434\\u043e\\u043c \\u0437\\u0430 \\u0434\\u0456\\u0442\\u044c\\u043c\\u0438 \\u0442\\u0430 \\u0437 \\u043c\\u0435\\u0434\\u0438\\u0447\\u043d\\u0438\\u043c \\u043e\\u0431\\u0441\\u043b\\u0443\\u0433\\u043e\\u0432\\u0443\\u0432\\u0430\\u043d\\u043d\\u044f\\u043c. \\u0421\\u044c\\u043e\\u0433\\u043e\\u0434\\u043d\\u0456 \\u0430\\u043a\\u0442\\u0443\\u0430\\u043b\\u044c\\u043d\\u0438\\u043c \\u0437\\u0430\\u043b\\u0438\\u0448\\u0430\\u0454\\u0442\\u044c\\u0441\\u044f \\u043f\\u0438\\u0442\\u0430\\u043d\\u043d\\u044f \\u043d\\u0435\\u043e\\u0431\\u0445\\u0456\\u0434\\u043d\\u043e\\u0441\\u0442\\u0456 \\u0441\\u043f\\u0440\\u043e\\u0449\\u0435\\u043d\\u043d\\u044f \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0443 \\u0432\\u0438\\u0437\\u043d\\u0430\\u043d\\u043d\\u044f \\u0456\\u043d\\u043e\\u0437\\u0435\\u043c\\u043d\\u0438\\u0445 \\u043a\\u0432\\u0430\\u043b\\u0456\\u0444\\u0456\\u043a\\u0430\\u0446\\u0456\\u0439 \\u0442\\u0430 \\u0437\\u0430\\u0431\\u0435\\u0437\\u043f\\u0435\\u0447\\u0435\\u043d\\u043d\\u044f \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u0443 \\u0434\\u043e \\u0440\\u0456\\u0437\\u043d\\u0438\\u0445 \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c \\u043f\\u0456\\u0434\\u0442\\u0440\\u0438\\u043c\\u043a\\u0438, \\u0442\\u0430\\u043a\\u0438\\u0445 \\u044f\\u043a \\u00ab\\u0414\\u043e\\u043f\\u043e\\u043c\\u043e\\u0436\\u0438 \\u043a\\u0443\\u043f\\u0438\\u0442\\u0438\\u00bb. \\u0412\\u0430\\u0436\\u043b\\u0438\\u0432\\u043e \\u0441\\u043f\\u0440\\u043e\\u0441\\u0442\\u0438\\u0442\\u0438 \\u043f\\u0440\\u043e\\u0446\\u0435\\u0441 \\u043f\\u0440\\u0430\\u0446\\u0435\\u0432\\u043b\\u0430\\u0448\\u0442\\u0443\\u0432\\u0430\\u043d\\u043d\\u044f \\u0442\\u0430 \\u0437\\u0430\\u0431\\u0435\\u0437\\u043f\\u0435\\u0447\\u0438\\u0442\\u0438 \\u043f\\u0456\\u0434\\u0442\\u0440\\u0438\\u043c\\u043a\\u0443 \\u0441\\u0430\\u043c\\u043e\\u0437\\u0430\\u0439\\u043d\\u044f\\u0442\\u043e\\u0441\\u0442\\u0456. \\u041d\\u0435\\u043e\\u0431\\u0445\\u0456\\u0434\\u043d\\u043e \\u0441\\u0442\\u0432\\u043e\\u0440\\u0438\\u0442\\u0438 \\u0443\\u043c\\u043e\\u0432\\u0438 \\u0434\\u043b\\u044f \\u043e\\u0442\\u0440\\u0438\\u043c\\u0430\\u043d\\u043d\\u044f \\u043c\\u0435\\u0434\\u0438\\u0447\\u043d\\u043e\\u0457 \\u0434\\u043e\\u043f\\u043e\\u043c\\u043e\\u0433\\u0438 \\u0442\\u0430 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f \\u043