ps:\/\/www.ipcc.ch\/pdf\/supporting-material\/ipcc_good_practice_guidance_paper_anthropogenic.pdf"},{"key":"BFnclimate2976_CR79","doi-asserted-by":"publisher","first-page":"570","DOI":"10.1002\/wcc.121","volume":"2","author":"GC Hegerl","year":"2011","unstructured":"Hegerl, G. C. & Zwiers, F. W. Use of models in detection and attribution of climate change. WIREs Clim. Change 2, 570\u2013591 (2011).","journal-title":"WIREs Clim. Change"},{"key":"BFnclimate2976_CR80","doi-asserted-by":"publisher","first-page":"623","DOI":"10.1002\/joc.3711","volume":"34","author":"I Harris","year":"2014","unstructured":"Harris, I. et al. Updated high-resolution grids of monthly climatic observations \u2014 the CRUTS 3.1 dataset. Int. J. Climatol. 34, 623\u2013642 (2014).","journal-title":"Int. J. Climatol."},{"key":"BFnclimate2976_CR81","doi-asserted-by":"publisher","first-page":"71","DOI":"10.5194\/essd-5-71-2013","volume":"5","author":"A Becker","year":"2013","unstructured":"Becker, A. et al. A description of the global land-surface precipitation data products of the Global Precipitation Climatology Centre with sample applications including centennial (trend) analysis from 1901\u2013present. Earth Syst. Sci. Data 5, 71\u201399 (2013).","journal-title":"Earth Syst. Sci. Data"},{"key":"BFnclimate2976_CR82","first-page":"181","volume":"7","author":"C Beck","year":"2004","unstructured":"Beck, C., Grieser, J. & Rudolf, B. A new monthly precipitation climatology for the global land areas for the period 1951 to 2000. Clim. Status Rep. 7, 181\u2013190 (2004).","journal-title":"Clim. Status Rep."}],"container-title":["Nature Climate Change"],"language":"en","link":[{"URL":"http:\/\/www.nature.com\/articles\/nclimate2976.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"http:\/\/www.nature.com\/articles\/nclimate2976","content-type":"text\/html","content-version":"vor","intended-application":"text-mining"},{"URL":"http:\/\/www.nature.com\/articles\/nclimate2976.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2023,8,18]],"date-time":"2023-08-18T19:39:38Z","timestamp":1692387578000},"score":41.871384,"resource":{"primary":{"URL":"https:\/\/www.nature.com\/articles\/nclimate2976"}},"issued":{"date-parts":[[2016,6,6]]},"references-count":82,"journal-issue":{"issue":"7","published-print":{"date-parts":[[2016,7]]}},"alternative-id":["BFnclimate2976"],"URL":"https:\/\/doi.org\/10.1038\/nclimate2976","ISSN":["1758-678X","1758-6798"],"issn-type":[{"value":"1758-678X","type":"print"},{"value":"1758-6798","type":"electronic"}],"published":{"date-parts":[[2016,6,6]]},"assertion":[{"value":"21 April 2015","order":1,"name":"received","label":"Received","group":{"name":"ArticleHistory","label":"Article History"}},{"value":"29 February 2016","order":2,"name":"accepted","label":"Accepted","group":{"name":"ArticleHistory","label":"Article History"}},{"value":"6 June 2016","order":3,"name":"first_online","label":"First Online","group":{"name":"ArticleHistory","label":"Article History"}},{"value":"7 June 2016","order":4,"name":"change_date","label":"Change Date","group":{"name":"ArticleHistory","label":"Article History"}},{"value":"Correction","order":5,"name":"change_type","label":"Change Type","group":{"name":"ArticleHistory","label":"Article History"}},{"value":"In the HTML version of this Perspective originally published, the second affiliation for Peter A. Scott was missing; this has now been corrected.","order":6,"name":"change_details","label":"Change Details","group":{"name":"ArticleHistory","label":"Article History"}},{"value":"The authors declare no competing financial interests.","order":1,"name":"Ethics","group":{"name":"EthicsHeading","label":"Competing interests"}}]},{"institution":[{"id":[{"id":"https:\/\/ror.org\/0040r6f76","id-type":"ROR","asserted-by":"publisher"},{"id":"https:\/\/www.isni.org\/0000000122923111","id-type":"ISNI","asserted-by":"publisher"},{"id":"https:\/\/www.wikidata.org\/entity\/Q1150437","id-type":"wikidata","asserted-by":"publisher"}],"name":"Te Herenga Waka\u2014Victoria University of Wellington","department":["School of Geography, Environment and Earth Sciences"]}],"indexed":{"date-parts":[[2026,7,30]],"date-time":"2026-07-30T17:05:47Z","timestamp":1785431147259,"version":"3.56.0"},"reference-count":0,"publisher":"Victoria University of Wellington Library","license":[{"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/www.wgtn.ac.nz\/library\/about-us\/policies-and-strategies\/copyright-for-the-researcharchive"}],"content-domain":{"domain":[],"crossmark-restriction":false},"abstract":"<jats:p>While the global fingerprint of climate change is becoming increasingly clear, the\npatterns of regional climate change remain blurred and uncertain. Climate change detection\nand attribution - the study of distinguishing long-term changes from internal variability and\nestimating the contributions of external factors \u2013 is particularly challenging at the regional\nscale. Regional detection and attribution is a historically challenging low signal-to-noise\nproblem as the signals (responses to external forcings) are small compared to the internal\nvariability (\u201cnoise\u201d). The predominant method, optimal fingerprinting, compares\nobservations against climate model-simulated response patterns and internal variability to\nidentify spatiotemporal fingerprints (unique patterns across space and time) of\nanthropogenic and natural climate change. In previous studies using fully-coupled models,\nsignificant temporal or spatially averaging is required to compensate for inadequate\nsamplings of internal variability. However, such averaging risks losing valuable spatial and\ntemporal information essential for regional detection.\n\nIn this dissertation, I wield the power of large ensembles of atmosphere-only model\nsimulations to apply optimal fingerprinting with minimal spatial or temporal averaging.\nThese ensembles provide unprecedented samplings of internal variability, allowing the full\nspatiotemporal complexity of the observations and model outputs to be utilized in the\noptimal fingerprinting analysis. I apply this method to two case studies \u2013 western North\nAmerican fire weather and New Zealand hydroclimate \u2013 which introduce multivariate and\nhydroclimate processes in topographically diverse regions to the regional detection\nproblem. Both anthropogenic and natural fingerprints are robustly detected in western\nNorth American fire weather and New Zealand temperature. Anthropogenic fingerprints in\nNew Zealand precipitation and streamflow trends are not detected, though natural\nfingerprints are detected when wetter areas are given more weight. In addition to\ndeepening the understanding of the effects of anthropogenic climate change in these\nregions, the wider impact of this thesis is the demonstration of the benefits \u2013 and caveats \u2013\nof using atmosphere-only models for the detection and attribution of regional climate\nchange.<\/jats:p>","DOI":"10.26686\/48s3-8r2d","type":"dissertation","created":{"date-parts":[[2025,10,10]],"date-time":"2025-10-10T14:38:12Z","timestamp":1760107092000},"approved":{"date-parts":[[2025,10,10]]},"source":"Crossref","is-referenced-by-count":0,"title":["Of Fire and Rain: Regional climate change detection and attribution"],"prefix":"10.26686","author":[{"given":"Laura","family":"Queen","sequence":"first","affiliation":[{"id":[{"id":"https:\/\/ror.org\/0040r6f76","id-type":"ROR","asserted-by":"publisher"},{"id":"https:\/\/www.isni.org\/0000000122923111","id-type":"ISNI","asserted-by":"publisher"}]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"11224","contributor":[{"sequence":"additional","affiliation":[],"role":[null]}],"deposited":{"date-parts":[[2025,10,10]],"date-time":"2025-10-10T14:38:13Z","timestamp":1760107093000},"score":40.670223,"degree":["Doctor of Philosophy"],"resource":{"primary":{"URL":"https:\/\/openaccess.wgtn.ac.nz\/articles\/thesis\/_\/30329944"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.26686\/48s3-8r2d"},{"indexed":{"date-parts":[[2026,6,3]],"date-time":"2026-06-03T23:54:20Z","timestamp":1780530860866,"version":"3.54.1"},"reference-count":0,"publisher":"Wiley","issue":"10","license":[{"start":{"date-parts":[[2021,7,8]],"date-time":"2021-07-08T00:00:00Z","timestamp":1625702400000},"content-version":"vor","delay-in-days":0,"URL":"http:\/\/onlinelibrary.wiley.com\/termsAndConditions#vor"}],"content-domain":{"domain":["rmets.onlinelibrary.wiley.com"],"crossmark-restriction":true},"short-container-title":["Weather"],"published-print":{"date-parts":[[2021,10]]},"DOI":"10.1002\/wea.4027","type":"journal-article","created":{"date-parts":[[2021,7,8]],"date-time":"2021-07-08T08:41:10Z","timestamp":1625733670000},"page":"324-324","update-policy":"https:\/\/doi.org\/10.1002\/crossmark_policy","source":"Crossref","is-referenced-by-count":5,"title":["Detection and attribution of climate change"],"prefix":"10.1002","volume":"76","author":[{"given":"Peter A.","family":"Stott","sequence":"first","affiliation":[{"name":"Met Office Hadley Centre  Exeter UK"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"John F. B.","family":"Mitchell","sequence":"additional","affiliation":[{"name":"Met Office Hadley Centre  Exeter UK"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"311","published-online":{"date-parts":[[2021,7,8]]},"container-title":["Weather"],"language":"en","link":[{"URL":"https:\/\/onlinelibrary.wiley.com\/doi\/pdf\/10.1002\/wea.4027","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/onlinelibrary.wiley.com\/doi\/full-xml\/10.1002\/wea.4027","content-type":"application\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/rmets.onlinelibrary.wiley.com\/doi\/pdf\/10.1002\/wea.4027","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2023,8,28]],"date-time":"2023-08-28T13:03:44Z","timestamp":1693227824000},"score":38.038593,"resource":{"primary":{"URL":"https:\/\/rmets.onlinelibrary.wiley.com\/doi\/10.1002\/wea.4027"}},"issued":{"date-parts":[[2021,7,8]]},"references-count":0,"journal-issue":{"issue":"10","published-print":{"date-parts":[[2021,10]]}},"alternative-id":["10.1002\/wea.4027"],"URL":"https:\/\/doi.org\/10.1002\/wea.4027","archive":["Portico"],"ISSN":["0043-1656","1477-8696"],"issn-type":[{"value":"0043-1656","type":"print"},{"value":"1477-8696","type":"electronic"}],"published":{"date-parts":[[2021,7,8]]},"assertion":[{"value":"2017-11-29","order":0,"name":"received","label":"Received","group":{"name":"publication_history","label":"Publication History"}},{"value":"2018-02-17","order":1,"name":"accepted","label":"Accepted","group":{"name":"publication_history","label":"Publication History"}},{"value":"2021-07-08","order":2,"name":"published","label":"Published","group":{"name":"publication_history","label":"Publication History"}}]}],"items-per-page":5,"query":{"start-index":0,"search-terms":null}}}