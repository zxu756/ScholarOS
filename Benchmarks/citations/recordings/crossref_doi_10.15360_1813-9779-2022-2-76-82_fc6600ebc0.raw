ge: a crucial step in fibroblast-to-myofibroblast differentiation. Mol Biol Cell. 2007; 18 (7): 2716\u20132727. DOI: 10.1091\/mbc.e06-10-0912. PMID: 17507651.","DOI":"10.1091\/mbc.e06-10-0912"},{"key":"ref30","doi-asserted-by":"crossref","unstructured":"Bernstein A. M., Greenberg R. S., Taliana L., Masur S. K. Urokinase anchors uPAR to the actin cytoskeleton. Invest Ophthalmol Vis Sci. 2004; 45 (9): 2967\u20132977. DOI: 10.1167\/iovs.04-0030. PMID: 15326109.","DOI":"10.1167\/iovs.04-0030"}],"container-title":["General Reanimatology"],"original-title":[],"link":[{"URL":"https:\/\/www.reanimatology.com\/rmt\/article\/viewFile\/2215\/1605","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"}],"deposited":{"date-parts":[[2022,5,2]],"date-time":"2022-05-02T12:14:39Z","timestamp":1651493679000},"score":1,"resource":{"primary":{"URL":"https:\/\/www.reanimatology.com\/rmt\/article\/view\/2215"}},"subtitle":[],"short-title":[],"issued":{"date-parts":[[2022,4,30]]},"references-count":30,"journal-issue":{"issue":"2","published-online":{"date-parts":[[2022,4,30]]}},"URL":"https:\/\/doi.org\/10.15360\/1813-9779-2022-2-76-82","relation":{},"ISSN":["2411-7110","1813-9779"],"issn-type":[{"value":"2411-7110","type":"electronic"},{"value":"1813-9779","type":"print"}],"subject":[],"published":{"date-parts":[[2022,4,30]]}}}