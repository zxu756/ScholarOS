first-page":"89","DOI":"10.1007\/s10584-013-0920-3","article-title":"Communities and blue carbon: The role of traditional management systems in providing benefits for carbon storage, biodiversity conservation and livelihoods","volume":"140","author":"Vierros","year":"2017","journal-title":"Clim. Change"},{"key":"B70","doi-asserted-by":"publisher","first-page":"27892","DOI":"10.1038\/s41598-025-12223-z","article-title":"Mixed provenance of organic carbon in Northeast Atlantic temperate intertidal seagrass sediments","volume":"15","author":"Ward","year":"2025","journal-title":"Sci. Rep."},{"key":"B71","doi-asserted-by":"publisher","DOI":"10.1016\/j.watres.2024.123017","article-title":"Nutrient loading accelerates breakdown of refractory dissolved organic carbon in seagrass ecosystem waters","volume":"273","author":"Zhang","year":"2025","journal-title":"Water Res."}],"container-title":["Frontiers in Marine Science"],"link":[{"URL":"https:\/\/www.frontiersin.org\/articles\/10.3389\/fmars.2026.1809172\/full","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,5,18]],"date-time":"2026-05-18T11:03:20Z","timestamp":1779102200000},"score":41.581505,"resource":{"primary":{"URL":"https:\/\/www.frontiersin.org\/articles\/10.3389\/fmars.2026.1809172\/full"}},"issued":{"date-parts":[[2026,5,18]]},"references-count":71,"alternative-id":["10.3389\/fmars.2026.1809172"],"URL":"https:\/\/doi.org\/10.3389\/fmars.2026.1809172","ISSN":["2296-7745"],"issn-type":[{"value":"2296-7745","type":"electronic"}],"published":{"date-parts":[[2026,5,18]]},"article-number":"1809172"},{"indexed":{"date-parts":[[2026,2,26]],"date-time":"2026-02-26T17:25:37Z","timestamp":1772126737836,"version":"3.50.1"},"description":"Supplemental Information for 10.1021\/acs.est.1c03782","reference-count":0,"publisher":"American Chemical Society (ACS)","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.1021\/acs.est.1c03782.s001","type":"component","created":{"date-parts":[[2021,10,26]],"date-time":"2021-10-26T09:45:46Z","timestamp":1635241546000},"source":"Crossref","is-referenced-by-count":0,"title":["Coastal Sediment Nutrient Enrichment Alters Seagrass Blue Carbon Sink Capacity"],"prefix":"10.1021","member":"316","deposited":{"date-parts":[[2021,11,16]],"date-time":"2021-11-16T04:50:00Z","timestamp":1637038200000},"score":40.745937,"resource":{"primary":{"URL":"https:\/\/pubs.acs.org\/doi\/suppl\/10.1021\/acs.est.1c03782\/suppl_file\/es1c03782_si_001.pdf"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.1021\/acs.est.1c03782.s001","relation":{"is-component-of":[{"id-type":"doi","id":"10.1021\/acs.est.1c03782","asserted-by":"object"}]}},{"indexed":{"date-parts":[[2026,10,13]],"date-time":"2026-10-13T18:35:23Z","timestamp":1791916523963,"version":"4.3.4"},"reference-count":77,"publisher":"Wiley","issue":"S2","license":[{"start":{"date-parts":[[2023,11,18]],"date-time":"2023-11-18T00:00:00Z","timestamp":1700265600000},"content-version":"am","delay-in-days":382,"URL":"http:\/\/onlinelibrary.wiley.com\/termsAndConditions#am"},{"start":{"date-parts":[[2022,11,18]],"date-time":"2022-11-18T00:00:00Z","timestamp":1668729600000},"content-version":"vor","delay-in-days":17,"URL":"http:\/\/onlinelibrary.wiley.com\/termsAndConditions#vor"}],"funder":[{"DOI":"10.13039\/501100000923","name":"Australian Research Council","doi-asserted-by":"publisher","id":[{"id":"10.13039\/501100000923","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100001798","name":"Edith Cowan University","doi-asserted-by":"publisher","id":[{"id":"10.13039\/501100001798","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100005299","name":"Vicerrector\u00eda de Investigaci\u00f3n, Universidad de Costa Rica","doi-asserted-by":"publisher","id":[{"id":"10.13039\/501100005299","id-type":"DOI","asserted-by":"publisher"}]}],"content-domain":{"domain":["aslopubs.onlinelibrary.wiley.com"],"crossmark-restriction":true},"short-container-title":["Limnology &amp; Oceanography"],"published-print":{"date-parts":[[2022,11]]},"abstract":"<jats:title>Abstract<\/jats:title><jats:p>Seagrass meadows composed of larger species are assumed to store larger sediment organic carbon (C<jats:sub>org<\/jats:sub>) stocks, storing more C<jats:sub>org<\/jats:sub> in their tissues and larger leaves promoting greater burial of seagrass and non\u2010seagrass C<jats:sub>org<\/jats:sub>. However, the influence of species composition on sediment C<jats:sub>org<\/jats:sub> stocks remains poorly understood mainly from challenges in isolating it from confounding factors. We assessed C<jats:sub>org<\/jats:sub> stocks in seagrass biomass and sediment of four species compositions in a tropical Caribbean meadow. We hypothesized that larger species would lead to higher sediment C<jats:sub>org<\/jats:sub> stocks, within a limited geomorphic setting and time frame. Seagrass biomass and surficial and sediment profiles were collected to measure seagrass morphometrics, \u03b4<jats:sup>13<\/jats:sup>C and \u03b4<jats:sup>15<\/jats:sup>N, dry bulk density, C<jats:sub>org<\/jats:sub> and inorganic carbon (C<jats:sub>inorg<\/jats:sub>) stocks, and grain size. Seagrass biomass C<jats:sub>org<\/jats:sub> stocks ranged from 0.04 to 3.7\u00a0Mg\u2009ha<jats:sup>\u22121<\/jats:sup>, with higher biomass C<jats:sub>org<\/jats:sub> stocks in compositions with larger species. Surficial sediment C<jats:sub>org<\/jats:sub> and C<jats:sub>inorg<\/jats:sub> stocks (to 1.5\u00a0cm) averaged 2.6\u2009\u00b1\u20090.6\u00a0Mg C<jats:sub>org<\/jats:sub> ha<jats:sup>\u22121<\/jats:sup> and 68.8\u2009\u00b1\u200914.6\u00a0Mg C<jats:sub>inorg<\/jats:sub> ha<jats:sup>\u22121<\/jats:sup>, respectively, and did not vary among species compositions. Isotopic analyses revealed a ~\u200950% contribution of seagrasses to surficial sediment C<jats:sub>org<\/jats:sub> in compositions with larger species, compared to a contribution of ~\u200935% for those of smaller species. This study provides novel blue carbon data from an understudied region and contributes to understanding the role of seagrass species composition on sediment carbon storage.<\/jats:p>","DOI":"10.1002\/lno.12258","type":"journal-article","created":{"date-parts":[[2022,11,18]],"date-time":"2022-11-18T08:25:31Z","timestamp":1668759931000},"update-policy":"https:\/\/doi.org\/10.1002\/crossmark_policy","source":"Crossref","is-referenced-by-count":10,"title":["Sediment organic carbon stocks were similar among four species compositions in a tropical seagrass meadow"],"prefix":"10.1002","volume":"67","author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-7513-7293","authenticated-orcid":false,"given":"Jimena","family":"Samper\u2010Villarreal","sequence":"first","affiliation":[{"name":"Marine Science and Limnology Research Center (Centro de Investigaci\u00f3n en Ciencias del Mar y Limnolog\u00eda, CIMAR), Ciudad de la Investigaci\u00f3n Universidad de Costa Rica, San Pedro  San Jos\u00e9 Costa Rica"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-5476-9953","authenticated-orcid":false,"given":"In\u00e9s","family":"Mazarrasa","sequence":"additional","affiliation":[{"name":"IHCantabria\u2014Instituto de Hidr\u00e1ulica Ambiental de la Universidad de Cantabria Parque Cient\u00edfico y Tecnol\u00f3gico de Cantabria  Santander Spain"},{"name":"Centro de Estudios Avanzados de Blanes Consejo Superior de Investigaciones Cient\u00edficas  Blanes Spain"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-1789-320X","authenticated-orcid":false,"given":"Pere","family":"Masqu\u00e9","sequence":"additional","affiliation":[{"name":"School of Science and Centre for Marine Ecosystems Research Edith Cowan University  Joondalup Western Australia Australia"},{"name":"International Atomic Energy Agency  Principality of Monaco Monaco"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-5973-0046","authenticated-orcid":false,"given":"Oscar","family":"Serrano","sequence":"additional","affiliation":[{"name":"Centro de Estudios Avanzados de Blanes Consejo Superior de Investigaciones Cient\u00edficas  Blanes Spain"},{"name":"School of Science and Centre for Marine Ecosystems Research Edith Cowan University  Joondalup Western Australia Australia"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jorge","family":"Cort\u00e9s","sequence":"additional","affiliation":[{"name":"Marine Science and Limnology Research Center (Centro de Investigaci\u00f3n en Ciencias del Mar y Limnolog\u00eda, CIMAR), Ciudad de la Investigaci\u00f3n Universidad de Costa Rica, San Pedro  San Jos\u00e9 Costa Rica"},{"name":"School of Biology and Zoology Museum Universidad de Costa Rica, San Pedro  San Jos\u00e9 Costa Rica"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"311","published-online":{"date-parts":[[2022,11,18]]},"reference":[{"key":"e_1_2_6_2_1","doi-asserted-by":"publisher","DOI":"10.3354\/meps291159"},{"key":"e_1_2_6_3_1","doi-asserted-by":"publisher","DOI":"10.5194\/bg-15-6791-2018"},{"key":"e_1_2_6_4_1","doi-asserted-by":"publisher","DOI":"10.1007\/s10021-011-9421-2"},{"key":"e_1_2_6_5_1","doi-asserted-by":"publisher","DOI":"10.5194\/bg-13-313-2016"},{"key":"e_1_2_6_6_1","doi-asserted-by":"publisher","DOI":"10.1038\/nclimate2763"},{"key":"e_1_2_6_7_1","doi-asserted-by":"publisher","DOI":"10.1016\/j.coastaleng.2021.103972"},{"key":"e_1_2_6_8_1","doi-asserted-by":"publisher","DOI":"10.1021\/cr050347q"},{"key":"e_1_2_6_9_1","first-page":"441","article-title":"Lagoon scale processes in a coastally influenced Caribbean system: Implications for the seagrass Thalassia testudinum","volume":"41","author":"Carruthers T. J. B.","year":"2005","journal-title":"Caribb. J. Sci."},{"key":"e_1_2_6_10_1","doi-asserted-by":"publisher","DOI":"10.1038\/s41559-021-01