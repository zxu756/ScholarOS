ogical Diversity University of St Andrews Fife UK"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Ir\u00e8ne","family":"Till\u2010Bottraud","sequence":"additional","affiliation":[{"name":"Universit\u00e9 Clermont Auvergne CNRS GEOLAB F\u201063000 Clermont\u2010Ferrand France"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"311","published-online":{"date-parts":[[2020,3,26]]},"reference":[{"key":"e_1_2_8_2_1","doi-asserted-by":"publisher","DOI":"10.1073\/pnas.1315179111"},{"key":"e_1_2_8_3_1","doi-asserted-by":"publisher","DOI":"10.1073\/pnas.1710455114"},{"key":"e_1_2_8_4_1","doi-asserted-by":"publisher","DOI":"10.1016\/j.biocon.2011.12.012"},{"key":"e_1_2_8_5_1","doi-asserted-by":"publisher","DOI":"10.1073\/pnas.0901652106"},{"key":"e_1_2_8_6_1","unstructured":"Barto\u0144 K.(2009).MuMIn: multi\u2010model inference. R package."},{"key":"e_1_2_8_7_1","doi-asserted-by":"publisher","DOI":"10.18637\/jss.v067.i01"},{"key":"e_1_2_8_8_1","doi-asserted-by":"publisher","DOI":"10.1890\/03-9000"},{"key":"e_1_2_8_9_1","doi-asserted-by":"publisher","DOI":"10.1111\/1365-2745.13171"},{"key":"e_1_2_8_10_1","volume-title":"Model Selection and Multimodel Inference: A Practical Information\u2010Theoretic Approach","author":"Burnham K.P.","year":"2002"},{"key":"e_1_2_8_11_1","volume-title":"Matrix Population Models. Construction, Analysis and Interpretation","author":"Caswell H.","year":"2001"},{"key":"e_1_2_8_12_1","doi-asserted-by":"publisher","DOI":"10.1002\/ecm.1228"},{"key":"e_1_2_8_13_1","doi-asserted-by":"publisher","DOI":"10.1086\/669155"},{"key":"e_1_2_8_14_1","doi-asserted-by":"publisher","DOI":"10.1016\/j.ecolmodel.2019.108760"},{"key":"e_1_2_8_15_1","doi-asserted-by":"publisher","DOI":"10.2307\/1551813"},{"key":"e_1_2_8_16_1","doi-asserted-by":"publisher","DOI":"10.1038\/nature09439"},{"key":"e_1_2_8_17_1","doi-asserted-by":"publisher","DOI":"10.1086\/430642"},{"key":"e_1_2_8_18_1","doi-asserted-by":"publisher","DOI":"10.1890\/02-0651"},{"