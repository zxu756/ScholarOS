075","volume":"30","author":[{"given":"Christina M.","family":"Willis","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"1757","published-online":{"date-parts":[[2007]]},"container-title":["Linguistics of the Tibeto-Burman Area"],"deposited":{"date-parts":[[2024,9,20]],"date-time":"2024-09-20T12:56:28Z","timestamp":1726836988000},"score":46.72136,"resource":{"primary":{"URL":"https:\/\/hdl.handle.net\/10356\/177916"}},"issued":{"date-parts":[[2007]]},"references-count":0,"journal-issue":{"issue":"2","published-online":{"date-parts":[[2007]]}},"URL":"https:\/\/doi.org\/10.32655\/ltba.30.2.04","ISSN":["0731-3500"],"issn-type":[{"value":"0731-3500","type":"print"}],"published":{"date-parts":[[2007]]}},{"institution":[{"name":"The Hong Kong University of Science and Technology","acronym":["HKUST"],"place":["Clear Water Bay, Kowloon, Hong Kong"]}],"indexed":{"date-parts":[[2026,9,18]],"date-time":"2026-09-18T00:04:31Z","timestamp":1789689871034,"version":"4.0.1"},"reference-count":0,"publisher":"The Hong Kong University of Science and Technology Library","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.14711\/thesis-hdl174727","type":"dissertation","created":{"date-parts":[[2026,9,17]],"date-time":"2026-09-17T23:10:28Z","timestamp":1789686628000},"approved":{"date-parts":[[2026]]},"source":"Crossref","is-referenced-by-count":0,"title":["Evidentiality across Borders: How Information Source and Access are Expressed in Tibeto-Burman"],"prefix":"10.14711","author":[{"given":"Mengyuan","family":"Tong","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"5801","deposited":{"date-parts":[[2026,9,17]],"date-time":"2026-09-17T23:11:30Z","timestamp":1789686690000},"score":43.985752,"degree":["Ph.D."],"resource":{"primary":{"URL":"https:\/\/hdl.handle.net\/1783.1\/174727"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.14711\/thesis-hdl174727"},{"indexed":{"date-parts":[[2025,6,28]],"date-time":"2025-06-28T12:43:14Z","timestamp":1751114594667},"reference-count":0,"publisher":"John Benjamins Publishing Company","issue":"2","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["LTBA"],"DOI":"10.32655\/ltba.23.2.02","type":"journal-article","created":{"date-parts":[[2024,9,20]],"date-time":"2024-09-20T16:43:36Z","timestamp":1726850616000},"source":"Crossref","is-referenced-by-count":1,"title":["Evidentials, inferentials and mirativity in Nepali"],"prefix":"10.1075","volume":"23","author":[{"given":"John","family":"Peterson","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"1757","published-online":{"date-parts":[[2000]]},"container-title":["Linguistics of the Tibeto-Burman Area"],"deposited":{"date-parts":[[2024,9,20]],"date-time":"2024-09-20T16:56:11Z","timestamp":1726851371000},"score":42.399784,"resource":{"primary":{"URL":"https:\/\/hdl.handle.net\/10356\/178071"}},"issued":{"date-parts":[[2000]]},"references-count":0,"journal-issue":{"issue":"2","published-online":{"date-parts":[[2000]]}},"URL":"https:\/\/doi.org\/10.32655\/ltba.23.2.02","ISSN":["0731-3500"],"issn-type":[{"value":"0731-3500","type":"print"}],"published":{"date-parts":[[2000]]}},{"indexed":{"date-parts":[[2026,4,24]],"date-time":"2026-04-24T22:48:31Z","timestamp":1777070911271,"version":"3.51.4"},"reference-count":0,"publisher":"California Digital Library (CDL)","issue":"1","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["Himalayan Linguistics"],"abstract":"<p>Classifications of evidentiality all include at least one \u2018reported\u2019, \u2018quotative\u2019 or \u2018hearsay\u2019 category. This category is found in many language groups that are attested to have evidentiality, including the Tibeto-Burman family. Although attested, reported evidentiality is often under-described in both descriptive grammars of specific languages, and typologies of evidentiality across the family. This survey of reported evidentiality in the Tibeto-Burman family found mention of reported evidentiality in descriptions of 88 of 130 languages. While there are clear patterns with regards to the morphosyntactic features of reported evidentiality across these languages, there is a great deal of variation in the semantic features, including the number of reported evidential distinctions and the specificity of source. This survey demonstrates that reported evidentiality is complex and varied across languages, even within the same family, and outlines ways to improve future documentation and description.<\/p>","DOI":"10.5070\/h920152301","type":"journal-article","created":{"date-parts":[[2021,11,18]],"date-time":"2021-11-18T11:35:18Z","timestamp":1637235318000},"source":"Crossref","is-referenced-by-count":3,"title":["Reported Evidentiality in Tibeto-Burman Languages"],"prefix":"10.5070","volume":"20","author":[{"given":"Lauren","family":"Gawne","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"29705","published-online":{"date-parts":[[2021,7,31]]},"container-title":["Himalayan Linguistics"],"link":[{"URL":"https:\/\/escholarship.org\/content\/qt3wf1j9bg\/qt3wf1j9bg.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"}],"deposited":{"date-parts":[[2026,4,24]],"date-time":"2026-04-24T22:24:53Z","timestamp":1777069493000},"score":41.504,"resource":{"primary":{"URL":"https:\/\/escholarship.org\/uc\/item\/3wf1j9bg"}},"issued":{"date-parts":[[2021,7,31]]},"references-count":0,"journal-issue":{"issue":"1","published-online":{"date-parts":[[2021,1,1]]}},"URL":"https:\/\/doi.org\/10.5070\/h920152301","ISSN":["1544-7502"],"issn-type":[{"value":"1544-7502","type":"electronic"}],"published":{"date-parts":[[2021,7,31]]}}],"items-per-page":5,"query":{"start-index":0,"search-terms":null}}}