en":"Ida","family":"Maria","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Muh","family":"Hatta","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Anwar","family":"Mallongi","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"2587","event":{"number":"3","sponsor":["ICST"],"acronym":"ICER-PH","name":"Proceedings of the 3rd International Conference on Environmental Risks and Public Health, ICER-PH 2018, 26-27, October 2018, Makassar, Indonesia","start":{"date-parts":[[2018,10,26]]},"location":"Makassar, Indonesia","end":{"date-parts":[[2018,10,27]]}},"container-title":["Proceedings of the Proceedings of the 3rd International Conference on Environmental Risks and Public Health, ICER-PH 2018, 26-27, October 2018, Makassar, Indonesia"],"deposited":{"date-parts":[[2024,9,21]],"date-time":"2024-09-21T17:03:56Z","timestamp":1726938236000},"score":30.004375,"resource":{"primary":{"URL":"http:\/\/eudl.eu\/doi\/10.4108\/eai.26-10-2018.2288705"}},"proceedings-subject":"ICER-PH","issued":{"date-parts":[[2019]]},"references-count":0,"URL":"https:\/\/doi.org\/10.4108\/eai.26-10-2018.2288705","published":{"date-parts":[[2019]]}},{"indexed":{"date-parts":[[2025,5,3]],"date-time":"2025-05-03T04:03:53Z","timestamp":1746245033389,"version":"3.40.4"},"reference-count":0,"publisher":"Fakultas Sains dan Teknologi UINSA","issue":"1","license":[{"start":{"date-parts":[[2025,4,25]],"date-time":"2025-04-25T00:00:00Z","timestamp":1745539200000},"content-version":"unspecified","delay-in-days":0,"URL":"http:\/\/creativecommons.org\/licenses\/by-nc-sa\/4.0"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["Jour. Health Sci Prev"],"abstract":"<jats:p>Leptospirosis is a disease caused by infection with Leptospira bacteria and is commonly found in tropical and subtropical regions, such as Indonesia. This study aimed to describe the demographic data, symptoms, and risk factors of suspected leptospirosis cases in Kendari Barat and Baruga Subdistricts, Kendari City, Southeast Sulawesi Province. Data were collected from epidemiological investigation reports from Benu-benua, Lepo-lepo, and Kandai Community Health Centers. Based on the data from suspected leptospirosis cases in Kendari City, most cases were found in females (60.6%), within the productive age group (66.7%), living in flood-prone areas (51.5%), and with the presence of rats inside the home (69.7%). Living in flood-prone areas and the presence of rats in the home were prominent risk factors among suspected leptospirosis cases. It was recommended that people of working age in Kendari City use personal protective equipment when working in environments with a high risk of transmission. Additionally, personal and household hygiene should be maintained, especially during floods and in the presence of rats, as these conditions increased the risk of leptospirosis transmission.<\/jats:p>","DOI":"10.29080\/jhsp.v9i1.1334","type":"journal-article","created":{"date-parts":[[2025,5,2]],"date-time":"2025-05-02T10:48:13Z","timestamp":1746182893000},"page":"32-37","source":"Crossref","is-referenced-by-count":0,"title":["Risk Factors and Demographic Profile of Suspected Leptospirosis Cases in Kendary City: Health Challenges in Flood-Prone Areas"],"prefix":"10.29080","volume":"9","author":[{"given":"Yudied","family":"Agung Mirasa","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Nuralim","family":"Ahzan","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Yustina","family":"Maria Oda","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Zhuria","family":"Alifsya Ramadhani","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Globila","family":"Nurika","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Moch.","family":"Sahri","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"11616","published-online":{"date-parts":[[2025,4,25]]},"container-title":["Journal of Health Science and Prevention"],"link":[{"URL":"https:\/\/jurnalfpk.uinsa.ac.id\/index.php\/jhsp\/article\/download\/1334\/443","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/jurnalfpk.uinsa.ac.id\/index.php\/jhsp\/article\/download\/1334\/443","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2025,5,2]],"date-time":"2025-05-02T10:48:14Z","timestamp":1746182894000},"score":29.57521,"resource":{"primary":{"URL":"https:\/\/jurnalfpk.uinsa.ac.id\/index.php\/jhsp\/article\/view\/1334"}},"issued":{"date-parts":[[2025,4,25]]},"references-count":0,"journal-issue":{"issue":"1","published-online":{"date-parts":[[2025,4,25]]}},"URL":"https:\/\/doi.org\/10.29080\/jhsp.v9i1.1334","ISSN":["2549-919X"],"issn-type":[{"value":"2549-919X","type":"electronic"}],"published":{"date-parts":[[2025,4,25]]}},{"indexed":{"date-parts":[[2026,11,12]],"date-time":"2026-11-12T19:05:53Z","timestamp":1794510353224,"version":"4.9.1"},"publisher-location":"London","reference-count":0,"publisher":"ICE Publishing","isbn-type":[{"value":"9780727757999","type":"print"},{"value":"9780727758002","type":"electronic"}],"content-domain":{"domain":[],"crossmark-restriction":false},"published-print":{"date-parts":[[2012,1]]},"DOI":"10.1680\/dams2012.57999.0027","type":"book-chapter","created":{"date-parts":[[2015,12,6]],"date-time":"2015-12-06T08:08:32Z","timestamp":1449389312000},"page":"326-333","source":"Crossref","is-referenced-by-count":0,"title":["Braid Burn Flood Storage Reservoirs"],"prefix":"10.1680","member":"140","publis