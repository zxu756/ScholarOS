k":[{"URL":"https:\/\/reicst.com.ua\/pmtl\/article\/download\/2023-10-01-01\/2023-10-01-01","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/reicst.com.ua\/pmtl\/article\/download\/2023-10-01-01\/2023-10-01-01","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2023,10,5]],"date-time":"2023-10-05T20:15:14Z","timestamp":1696536914000},"score":44.918133,"resource":{"primary":{"URL":"https:\/\/reicst.com.ua\/pmtl\/article\/view\/2023-10-01-01"}},"issued":{"date-parts":[[2023,10,2]]},"references-count":13,"journal-issue":{"issue":"10","published-online":{"date-parts":[[2023,10,5]]}},"URL":"https:\/\/doi.org\/10.54929\/2786-5746-2023-10-01-01","ISSN":["2786-5746"],"issn-type":[{"type":"electronic","value":"2786-5746"}],"published":{"date-parts":[[2023,10,2]]}}],"items-per-page":5,"query":{"start-index":0,"search-terms":null}}}