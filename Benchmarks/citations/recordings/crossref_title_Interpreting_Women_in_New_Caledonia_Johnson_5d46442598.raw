480109","type":"electronic"}],"content-domain":{"domain":[],"crossmark-restriction":false},"published-print":{"date-parts":[[2021,6,24]]},"abstract":"<p>The presence of Christianity in New Caledonia can be traced back to missionary work in the 1840s. In the Wallis and Futuna Islands, a Marist priest began the first mission in 1837. The population of New Caledonia was 84.8% Christian as of 2020. 97% of the population of the Wallis and Futuna Islands was Christian as of 2020.<\/p>","DOI":"10.3366\/edinburgh\/9781474480079.003.0010","type":"book-chapter","created":{"date-parts":[[2026,1,30]],"date-time":"2026-01-30T12:11:30Z","timestamp":1769775090000},"page":"82-90","source":"Crossref","is-referenced-by-count":0,"title":["New Caledonia, and Wallis and Futuna Islands"],"prefix":"10.3366","author":[{"given":"Nathalie","family":"Cawidrone","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"1931","published-online":{"date-parts":[[2026,1,22]]},"container-title":["Christianity in Oceania"],"original-title":["New Caledonia, and Wallis and Futuna Islands"],"language":"en","deposited":{"date-parts":[[2026,1,30]],"date-time":"2026-01-30T12:11:30Z","timestamp":1769775090000},"score":24.228048,"resource":{"primary":{"URL":"https:\/\/academic.oup.com\/edinburgh-scholarship-online\/book\/62133\/chapter\/549443902"}},"editor":[{"given":"Kenneth R.","family":"Ross","sequence":"additional","affiliation":[],"role":[{"role":"editor","vocabulary":"crossref"}]},{"given":"Katalina","family":"Tahaafe-Williams","sequence":"additional","affiliation":[],"role":[{"role":"editor","vocabulary":"crossref"}]},{"given":"Todd M.","family":"Johnson","sequence":"additional","affiliation":[],"role":[{"role":"editor","vocabulary":"crossref"}]}],"issued":{"date-parts":[[2021,6,24]]},"ISBN":["9781474480079","9781474480109"],"references-count":0,"URL":"https:\/\/doi.org\/10.3366\/edinburgh\/9781474480079.003.0010","relation":{"is-identical-to":[{"id-type":"do