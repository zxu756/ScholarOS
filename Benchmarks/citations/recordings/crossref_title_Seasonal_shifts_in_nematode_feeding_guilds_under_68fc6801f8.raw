itle":"Appl. Soil Ecol."},{"key":"10.1016\/j.ejsobi.2012.11.003_bib56","doi-asserted-by":"crossref","first-page":"1763","DOI":"10.1016\/j.soilbio.2005.02.010","article-title":"Nematode succession and microfauna \u2013 microorganism interactions during root residue decomposition","volume":"37","author":"Georgieva","year":"2005","journal-title":"Soil Biol. Biochem."},{"key":"10.1016\/j.ejsobi.2012.11.003_bib57","doi-asserted-by":"crossref","first-page":"199","DOI":"10.1007\/s00374-003-0586-5","article-title":"Significant changes in soil microfauna in grazed pasture under elevated carbon dioxide","volume":"37","author":"Yeates","year":"2003","journal-title":"Biol. Fertil. Soils"},{"key":"10.1016\/j.ejsobi.2012.11.003_bib58","doi-asserted-by":"crossref","first-page":"159","DOI":"10.1023\/A:1004318318307","article-title":"Nitrogen mineralization by bacterial-feeding nematodes: veri\ufb01cation and measurement","volume":"203","author":"Ferris","year":"1998","journal-title":"Plant Soil"}],"container-title":["European Journal of Soil Biology"],"language":"en","link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S116455631200115X?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S116455631200115X?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}],"deposited":{"date-parts":[[2025,10,22]],"date-time":"2025-10-22T05:54:25Z","timestamp":1761112465000},"score":31.096367,"resource":{"primary":{"URL":"https:\/\/linkinghub.elsevier.com\/retrieve\/pii\/S116455631200115X"}},"issued":{"date-parts":[[2013,3]]},"references-count":58,"alternative-id":["S116455631200115X"],"URL":"https:\/\/doi.org\/10.1016\/j.ejsobi.2012.11.003","ISSN":["1164-5563"],"issn-type":[{"value":"1164-5563","type":"print"}],"published":{"date-parts":[[2013,3]]},"assertion":[{"value":"Elsevier","name":"publisher","label":"This article is maintained by"},{"value":"Determinants for seasonal change of nematode community composition under long-term application of organic manure in an acid soil in subtropical China","name":"articletitle","label":"Article Title"},{"value":"European Journal of Soil Biology","name":"journaltitle","label":"Journal Title"},{"value":"https:\/\/doi.org\/10.1016\/j.ejsobi.2012.11.003","name":"articlelink","label":"CrossRef DOI link to publisher maintained version"},{"value":"article","name":"content_type","label":"Content Type"},{"value":"Copyright \u00a9 2012 Elsevier Masson SAS. All rights reserved.","name":"copyright","label":"Copyright"}]},{"indexed":{"date-parts":[[2026,8,14]],"date-time":"2026-08-14T08:33:08Z","timestamp":1786696388408,"version":"build-2736575974"},"posted":{"date-parts":[[2022]]},"group-title":"SSRN","reference-count":0,"publisher":"Elsevier BV","content-domain":{"domain":[],"crossmark-restriction":false},"abstract":"<jats:p>Monoculture practices under conventional tillage (CT) are detrimental to sustainable soil ecosystem functions and services under intensive agriculture practices, ultimately diminishing net benefits. Conservation practices, such as no-till (NT) and cover crops (CC) can nurture sustainable soil ecosystem functions and services. The impact of introducing CC, grazing, intercropping, and reverting to tillage in a long-term NT continuous wheat system on soil properties was evaluated in three years of implementation. Treatments were CT and combinations of NT, CC, grazing, and intercropping wheat with radishes and turnips. Reverting to tillage after 12 years of NT significantly increased bulk density and reduced total porosity compared to NT with CC. In addition, CT significantly decreased large macroaggregates, mean weight diameter, and labile C within large macroaggregates and increased small macroaggregates compared to CC treatments. Cover crops enhanced NT as evident in significant improvements in bulk density, total porosity, soil macroaggregates, and mean weight diameter. Flash grazing CC did not result in any adverse effects compared to all other treatments for measured parameters. Ultimately, reverting to tillage in a long-term NT system significantly degraded soil physical property. In contrast, implementing cover crops to long-term continuous wheat systems trended toward soil improvements. Flash grazing cover crops can be successfully implemented in no-till systems without adversely affecting soil physical properties or labile C pools.<\/jats:p>","DOI":"10.2139\/ssrn.4035286","type":"posted-content","created":{"date-parts":[[2022,2,17]],"date-time":"2022-02-17T07:36:31Z","timestamp":1645083391000},"source":"Crossref","is-referenced-by-count":0,"title":["Enhancing Long-Term No-Till Wheat Systems with Cover Crops and Flash Grazing"],"prefix":"10.2139","author":[{"given":"Partson","family":"Mubvumba","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-9142-7963","authenticated-orcid":true,"given":"Paul  B.","family":"DeLaune","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Frank  M.","family":"Hons","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"78","deposited":{"date-parts":[[2026,8,14]],"date-time":"2026-08-14T08:18:38Z","timestamp":1786695518000},"score":30.024162,"resource":{"primary":{"URL":"https:\/\/www.ssrn.com\/abstract=4035286"}},"issued":{"date-parts":[[2022]]},"references-count":0,"URL":"https:\/\/doi.org\/10.2139\/ssrn.4035286","published":{"date-parts":[[2022]]},"subtype":"preprint"},{"institution":[{"name":"Universidade de S\u00e3o Paulo","place":["Piracicaba"],"department":["Escola Superior de Agricultura Luiz de Queiroz"]}],"indexed":{"date-parts":[[2026,6,16]],"date-time":"2026-06-16T14:16:34Z","timestamp":1781619394394,"version":"3.54.5"},"reference-count":0,"publisher":"Universidade de S\u00e3o Paulo. Ag\u00eancia de Bibliotecas e Cole\u00e7\u00f5es Digitais","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.11606\/d.11.2020.tde-04052020-123116","type":"dissertation","created":{"date-parts":[[2020,5,5]],"date-time":"2020-05-05T09:52:07Z","timestamp":1588672327000},"approved":{"date-parts":[[2020,5,5]]},"source":"Crossref","is-referenced-by-count":0,"title":["Sulfur speciation in a tropical soil under long-term no-till amended with lime and phosphogypsum"],"prefix":"10.11606","author":[{"given":"Rodolfo Fagundes","family":"Costa","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"4873","link":[{"URL":"http:\/\/www.teses.usp.br\/teses\/disponiveis\/11\/11140\/tde-04052020-123116\/publico\/Rodolfo_Fagundes_Costa_versao_revisada.pdf","content-type":"application\/octet-stream","content-version":"vor","intended-application":"text-mining"},{"URL":"http:\/\/www.teses.usp.br\/teses\/disponiveis\/11\/11140\/tde-04052020-123116\/publico\/Rodolfo_Fagundes_Costa_versao_revisada.pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,6,16]],"date-time":"2026-06-16T13:21:21Z","timestamp":1781616081000},"score":29.456923,"degree":["Mestrado em Solos e Nutri\u00e7\u00e3o de Plantas"],"resource":{"primary":{"URL":"https:\/\/teses.usp.br\/teses\/disponiveis\/11\/11140\/tde-04052020-123116\/"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.11606\/d.11.2020.tde-04052020-123116"},{"indexed":{"date-parts":[[2026,2,28]],"date-time":"2026-02-28T08:40:54Z","timestamp":1772268054164,"version":"3.50.1"},"reference-count":0,"publisher":"PeerJ","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.7717\/peerj.11204\/supp-2","type":"component","created":{"date-parts":[[2021,5,7]],"date-time":"2021-05-07T06:27:16Z","timestamp":1620368836000},"source":"Crossref","is-referenced-by-count":0,"title":["Supplemental Information 2: Abundance of different nematode feeding groups (individuals per g dry soil) in the long-term fertilization experiment in Lanna, Sweden; mean (SE)"],"prefix":"10.7717","member":"4443","deposited":{"date-parts":[[2021,5,7]],"date-time":"2021-05-07T06:27:21Z","timestamp":1620368841000},"score":29.058725,"resource":{"primary":{"URL":"https:\/\/peerj.com\/articles\/11204\/supp-2"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.7717\/peerj.11204\/supp-2","relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj.11204","asserted-by":"object"}]}}],"items-per-page":5,"query":{"start-index":0,"search-terms":null}}}