{"status":"ok","message-type":"work","message-version":"1.0.0","message":{"indexed":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T21:58:21Z","timestamp":1791496701035,"version":"4.3.4"},"reference-count":76,"publisher":"Oxford University Press (OUP)","issue":"3","license":[{"start":{"date-parts":[[2023,8,24]],"date-time":"2023-08-24T00:00:00Z","timestamp":1692835200000},"content-version":"vor","delay-in-days":50,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0\/"}],"funder":[{"DOI":"10.13039\/501100001475","name":"Nanyang Technological University","doi-asserted-by":"publisher","id":[{"id":"10.13039\/501100001475","id-type":"DOI","asserted-by":"publisher"}]}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":[],"published-print":{"date-parts":[[2023,7,5]]},"abstract":"<jats:title>Abstract<\/jats:title>\n                  <jats:p>G-quadruplexes (G4s) are secondary structures abundant in DNA that may play regulatory roles in cells. Despite the ubiquity of the putative G-quadruplex-forming sequences (PQS) in the human genome, only a small fraction forms G4 structures in cells. Folded G4, histone methylation and chromatin accessibility are all parts of the complex cis regulatory landscape. We propose an approach for prediction of\u00a0G4 formation in cells that incorporates epigenetic and chromatin accessibility data. The novel approach termed epiG4NN efficiently predicts cell-specific G4 formation in live cells based on a local epigenomic snapshot. Our results confirm the close relationship between H3K4me3 histone methylation, chromatin accessibility and G4 structure formation. Trained on A549 cell data, epiG4NN was then able to predict G4 formation in HEK293T and K562 cell lines. We observe the dependency of model performance with different epigenetic features on the underlying experimental condition of G4 detection. We expect that this approach will contribute to the systematic understanding of correlations between structural and epigenomic feature landscape.<\/jats:p>","DOI":"10.1093\/nargab\/lqad071","type":"journal-article","created":{"date-parts":[[2023,7,26]],"date-time":"2023-07-26T07:58:14Z","timestamp":1690358294000},"source":"Crossref","is-referenced-by-count":18,"title":["Prediction of G4 formation in live cells with epigenetic data: a deep learning approach"],"prefix":"10.1093","volume":"5","author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-6499-3692","authenticated-orcid":false,"given":"Anna","family":"Korsakova","sequence":"first","affiliation":[{"name":"School of Physical and Mathematical Sciences, Nanyang Technological University ,\u00a0 637371 , Singapore"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-4970-3861","authenticated-orcid":false,"given":"Anh Tu\u00e2n","family":"Phan","sequence":"additional","affiliation":[{"name":"School of Physical and Mathematical Sciences, Nanyang Technological University ,\u00a0 637371 , Singapore"},{"name":"NTU Institute of Structural Biology, Nanyang Technological University ,\u00a0 636921 , Singapore"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"286","published-online":{"date-parts":[[2023,8,24]]},"reference":[{"key":"2023082413415291600_B1","doi-asserted-by":"crossref","first-page":"414","DOI":"10.1016\/j.tcb.2009.05.002","article-title":"G-quadruplex structures: in vivo evidence and function","volume":"19","author":"Lipps","year":"2009","journal-title":"Trends Cell Biol."},{"key":"2023082413415291600_B2","doi-asserted-by":"crossref","first-page":"8627","DOI":"10.1093\/nar\/gkv862","article-title":"Survey and summary G-quadruplexes and their regulatory roles in biology","volume":"43","author":"Rhodes","year":"2015","journal-title":"Nucleic Acids Res."},{"key":"2023082413415291600_B3","doi-asserted-by":"crossref","first-page":"678","DOI":"10.1016\/j.cell.2011.04.015","article-title":"DNA replication through G-quadruplex motifs is promoted by the saccharomyces cerevisiae Pif1 DNA helicase","volume":"145","author":"Paeschke","year":"2011","journal-title":"Cell"},{"key":"2023082413415291600_B4","doi-asserted-by":"crossref","first-page":"825","DOI":"10.1038\/342825a0","article-title":"Telomeric DNA dimerizes by formation of guanine tetrads between hairpin loops","volume":"342","author":"Sundquist","year":"1989","journal-title":"Nature"},{"key":"2023082413415291600_B5","doi-asserted-by":"crossref","first-page":"371","DOI":"10.1093\/nar\/gkh181","article-title":"Telomerase downregulation induced by the G-quadruplex ligand 12459 in A549 cells is mediated by hTERT RNA alternative splicing","volume":"32","author":"Gomez","year":"2004","journal-title":"Nucleic Acids Res."},{"key":"2023082413415291600_B6","doi-asserted-by":"crossref","first-page":"218","DOI":"10.1038\/nchembio864","article-title":"An RNA G-quadruplex in the 5\u2032 UTR of the NRAS proto-oncogene modulates translation","volume":"3","author":"Kumari","year":"2007","journal-title":"Nat. Chem. Biol."},{"key":"2023082413415291600_B7","doi-asserted-by":"crossref","first-page":"1290","DOI":"10.1261\/rna.1001708","article-title":"Inhibition of translation in living eukaryotic cells by an RNA G-quadruplex motif","volume":"14","author":"Arora","year":"2008","journal-title":"RNA"},{"key":"2023082413415291600_B8","doi-asserted-by":"crossref","first-page":"2296","DOI":"10.1101\/gad.305862.117","article-title":"RNA G-quadruplex secondary structure promotes alternative splicing via the RNA-binding protein hnRNPF","volume":"31","author":"Huang","year":"2017","journal-title":"Genes Dev."},{"key":"2023082413415291600_B9","doi-asserted-by":"crossref","first-page":"4727","DOI":"10.1093\/nar\/gks068","article-title":"5\u2032-UTR RNA G-quadruplexes: translation regulation and targeting","volume":"40","author":"Bugaut","year":"2012","journal-title":"Nucleic Acids Res."},{"key":"2023082413415291600_B10","doi-asserted-by":"crossref","first-page":"4598","DOI":"10.1093\/nar\/gkn380","article-ti