ht"}],"article-number":"131872"},{"institution":[{"name":"Lawrence Livermore National Laboratory (LLNL)","acronym":["LLNL"],"place":["Livermore, CA (United States)"]},{"name":"US Department of Energy (US)"}],"indexed":{"date-parts":[[2022,3,29]],"date-time":"2022-03-29T14:58:03Z","timestamp":1648565883855},"reference-count":0,"publisher":"Office of Scientific and Technical Information (OSTI)","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.2172\/15005559","type":"report","created":{"date-parts":[[2007,4,17]],"date-time":"2007-04-17T15:21:50Z","timestamp":1176823310000},"source":"Crossref","is-referenced-by-count":0,"title":["Surface topographies of two-year coupons of titanium grade 16 from long-term testing"],"prefix":"10.2172","author":[{"given":"P J","family":"Bedrossian","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"960","published-online":{"date-parts":[[1999,12,28]]},"deposited":{"date-parts":[[2018,8,18]],"date-time":"2018-08-18T03:14:46Z","timestamp":1534562086000},"score":28.99216,"resource":{"primary":{"URL":"http:\/\/www.osti.gov\/servlets\/purl\/15005559\/"}},"issued":{"date-parts":[[1999,12,28]]},"references-count":0,"URL":"https:\/\/doi.org\/10.2172\/15005559","published":{"date-parts":[[1999,12,28]]}},{"indexed":{"date-parts":[[2026,5,5]],"date-time":"2026-05-05T12:08:30Z","timestamp":1777982910992,"version":"3.51.4"},"description":"Supplemental Information for 10.1021\/acsaelm.5c02225","reference-count":0,"publisher":"American Chemical Society (ACS)","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.1021\/acsaelm.5c02225.s001","type":"component","created":{"date-parts":[[2026,2,11]],"date-time":"2026-02-11T20:00:23Z","timestamp":1770840023000},"source":"Crossref","is-referenced-by-count":0,"title":["Cyclic OxidationReduction Cleaning for Microstructural and Chemical Restoration of Copper after Chemical Mechanical Polishing"],"prefix":"10.1021","member":"316","deposited":{"date-parts":[[2026,2,24]],"date-time":"2026-02-24T08:48:41Z","timestamp":1771922921000},"score":27.290497,"resource":{"primary":{"URL":"https:\/\/pubs.acs.org\/doi\/suppl\/10.1021\/acsaelm.5c02225\/suppl_file\/el5c02225_si_001.pdf"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.1021\/acsaelm.5c02225.s001","relation":{"is-component-of":[{"id-type":"doi","id":"10.1021\/acsaelm.5c02225","asserted-by":"object"}]}},{"indexed":{"date-parts":[[2026,9,28]],"date-time":"2026-09-28T08:58:05Z","timestamp":1790585885037,"version":"4.1.0"},"reference-count":0,"publisher":"American Academy of Implant Dentistry","content-domain":{"domain":[],"crossmark-restriction":false},"published-print":{"date-parts":[[2025,12,26]]},"abstract":"<jats:title>ABSTRACT<\/jats:title>\n                  <jats:p>The effectiveness of different polishing methods in reducing the surface roughness of titanium discs roughened with various techniques was evaluated in the current study. Surface roughness was the sole outcome parameter, as smoother titanium surfaces are generally considered beneficial for biofilm reduction, although the relationship with clinical performance is multifactorial and context dependent. A total of 150 Grade V titanium discs (10\u00d72.5 mm) were prepared. To ensure standardization, all samples were polished with silicone carbide sandpaper for 30 seconds, and baseline roughness values were recorded. The specimens were randomly assigned to five roughening groups: carbide bur, diamond rotary instrument, Er:YAG laser, airflow, and soft tissue bur. Each group was subdivided into three polishing subgroups (n=10): pumice, polishing paste, and silicone rubber polisher, resulting in 15 groups. Roughness was measured after roughening and polishing. One representative sample from each group was examined with scanning electron microscopy (SEM) at \u00d73000 magnification to qualitatively assess micromorphological alterations. The highest roughness was observed after carbide bur treatment. Silicone polishers most effectively reduced roughness in carbide and soft tissue bur groups. Pumice polishing was more effective on the diamond rotary instrument, Er:YAG laser, and airflow groups. SEM supported profilometric findings. Statistically significant differences were observed among groups (P &lt; 0.05). Treatments applied to titanium surfaces interacted differently with surface topography. Carbide bur created the roughest surface, while silicone polishers produced the smoothest. SEM confirmed smoother topographies after polishing.<\/jats:p>","DOI":"10.1563\/aaid-joi-d-25-00189","type":"journal-article","created":{"date-parts":[[2026,2,11]],"date-time":"2026-02-11T00:52:03Z","timestamp":1770771123000},"source":"Crossref","is-referenced-by-count":0,"title":["Surface Roughness and Morphological Alterations of Titanium After Various Roughening and Polishing Treatments"],"prefix":"10.1563","author":[{"given":"Edanur","family":"Nezir","sequence":"first","affiliation":[{"name":"Dt, Private Practice, Istanbul, Turkey ORCID: 0009-0007-0027-8554"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Akanay","family":"Copuroglu","sequence":"additional","affiliation":[{"name":"Assistant Professor, Department of Prosthodontics, Istanbul Galata University School of Dentistry, Haciahmet, Irmak Cd. DLP 1-9, Beyoglu, Istanbul, Turkey ORCID: 0000-0003-0130-4965"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Ozgun Yusuf","family":"Ozyilmaz","sequence":"additional","affiliation":[{"name":"Professor, Department of Prosthodontics, Istanbul Galata University School of Dentistry, Haciahmet, Irmak Cd. DLP 1-9, Beyoglu, Istanbul, Turkey ORCID: 0000-0003-4802-1604"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"434","container-title":["Journal of Oral Implantology"],"link":[{"URL":"https:\/\/joi.kglmeridian.com\/view\/journals\/orim\/aop\/article-10.1563-aaid-joi-D-25-00189\/article-10.1563-aaid-joi-D-25-00189.xml","content-type":"text\/html","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/joi.kglmeridian.com\/downloadpdf\/journals\/orim\/aop\/article-10.1563-aaid-joi-D-25-00189\/article-10.1563-aaid-joi-D-25-00189.xml","content-type":"text\/html","content-version":"vor","intended-application":"syndication"},{"URL":"https:\/\/joi.kglmeridian.com\/downloadpdf\/journals\/orim\/aop\/article-10.1563-aaid-joi-D-25-00189\/article-10.1563-aaid-joi-D-25-00189.xml","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,9,28]],"date-time":"2026-09-28T08:26:59Z","timestamp":1790584019000},"score":27.093716,"resource":{"primary":{"URL":"https:\/\/joi.kglmeridian.com\/view\/journals\/orim\/aop\/article-10.1563-aaid-joi-D-25-00189\/article-10.1563-aaid-joi-D-25-00189.xml"}},"issued":{"date-parts":[[2025,12,26]]},"references-count":0,"URL":"https:\/\/doi.org\/10.1563\/aaid-joi-d-25-00189","ISSN":["0160-6972","1548-1336"],"issn-type":[{"value":"0160-6972","type":"print"},{"value":"1548-1336","type":"electronic"}],"published":{"date-parts":[[2025,12,26]]}}],"items-per-page":5,"query":{"start-index":0,"search-terms":null}}}