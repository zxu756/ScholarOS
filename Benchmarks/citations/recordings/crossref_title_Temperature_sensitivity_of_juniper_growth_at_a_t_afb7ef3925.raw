t measurement in fully stocked stands and it can be estimated on any site with a regression model involving slope gradient, exposure, landform, and parent material. Potential biomass production is proportional to this site index. Forest Sci. 27:593-601.<\/jats:p>","DOI":"10.1093\/forestscience\/27.3.593","type":"journal-article","created":{"date-parts":[[2025,10,8]],"date-time":"2025-10-08T10:22:21Z","timestamp":1759918941000},"page":"593-601","source":"Crossref","is-referenced-by-count":0,"title":["Site Quality and Growth of Pinyon-Juniper Stands in Nevada"],"prefix":"10.1007","volume":"27","author":[{"given":"Richard O.","family":"Meeuwig","sequence":"first","affiliation":[{"name":"Research Associate, Renewable Natural Resources Division, College of Agriculture, University of Nevada Reno, Reno, Nevada 89557"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Stephen V.","family":"Cooper","sequence":"additional","affiliation":[{"name":"Research Associate, Renewable Natural Resources Division, College of Agriculture, University of Nevada Reno, Reno, Nevada 89557"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"297","container-title":["Forest Science"],"original-title":["Site Quality and Growth of Pinyon-Juniper Stands in Nevada"],"language":"en","deposited":{"date-parts":[[2026,2,9]],"date-time":"2026-02-09T22:57:42Z","timestamp":1770677862000},"score":28.668385,"resource":{"primary":{"URL":"https:\/\/academic.oup.com\/forestscience\/article\/27\/3\/593\/4656676"}},"issued":{"date-parts":[[1981,9,1]]},"references-count":0,"journal-issue":{"issue":"3","published-print":{"date-parts":[[1981,9,1]]}},"URL":"https:\/\/doi.org\/10.1093\/forestscience\/27.3.593","ISSN":["0015-749X","1938-3738"],"issn-type":[{"value":"0015-749X","type":"print"},{"value":"1938-3738","type":"electronic"}],"published":{"date-parts":[[1981,9,1]]}}],"items-per-page":5,"query":{"start-index":0,"search-terms":null}}}