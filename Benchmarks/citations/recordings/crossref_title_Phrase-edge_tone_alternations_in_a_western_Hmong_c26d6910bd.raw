{"status":"ok","message-type":"work-list","message-version":"1.0.0","message":{"facets":{},"total-results":34555,"items":[{"indexed":{"date-parts":[[2026,8,3]],"date-time":"2026-08-03T10:45:08Z","timestamp":1785753908543,"version":"3.56.0"},"edition-number":"1","reference-count":3,"publisher":"Oxford University PressNew York, NY","isbn-type":[{"value":"9780197852699","type":"electronic"}],"content-domain":{"domain":[],"crossmark-restriction":false},"published-print":{"date-parts":[[2026,4,9]]},"abstract":"<jats:title>Summary<\/jats:title>\n                  <jats:p>The Hmong from Laos became entangled in global political and military confrontations during the 20th century. Due to their involvement with American military personnel during the \u201cSecret War of Laos,\u201d which supported the larger Vietnam War, more than 150,000 Hmong were displaced beginning in 1975 and subsequently sought refuge in Western countries. Their mostly agrarian background led those involved in resettling refugees to believe that the Hmong refugees would struggle in modern society. Although many initially faced significant challenges, including cultural adaptation and economic integration, Hmong refugees have demonstrated remarkable resilience and adaptability. They have transformed their position as marginalized newcomers into community members making substantial contributions to local economies, education systems, and political landscapes, and their efforts and achievements have enabled the Hmong community\u2019s ability to preserve their cultural heritage while actively shaping the narratives about their community.<\/jats:p>","DOI":"10.1093\/9780197852699.003.0092","type":"reference-entry","created":{"date-parts":[[2026,4,11]],"date-time":"2026-04-11T23:54:31Z","timestamp":1775951671000},"source":"Crossref","is-referenced-by-count":0,"title":["Hmong Communities in the Western Hemisphere, 1975\u20132025"],"prefix":"10.1093","author":[{"given":"Chia Youyee","family":"Vang","sequence":"first","affiliation":[{"name":"University of Wisconsin\u2013Milwaukee ,","place":["USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"286","reference":[{"key":"2026080305225851500_workid-USAC0057281-book-part-92-ref-1","volume-title":"Follow the New Way: American Refugee Resettlement Policy and Hmong Religious Change","author":"Borja","year":"2023"},{"key":"2026080305225851500_workid-USAC0057281-book-part-92-ref-2","volume-title":"Harvesting Pa Chay\u2019s Wheat: The Hmong and America\u2019s Secret War in Laos","author":"Quincy","year":"2000"},{"key":"2026080305225851500_workid-USAC0057281-book-part-92-ref-3","doi-asserted-by":"crossref","DOI":"10.1215\/9781478012849","volume-title":"History on the Run: Secrecy, Fugitivity, and Hmong Refugee Epistemologies","author":"Vang","year":"2021"}],"container-title":["Oxford Research Encyclopedia of Migration Studies"],"language":"en","link":[{"URL":"https:\/\/academic.oup.com\/book\/chapter-pdf\/68069212\/book_62568_section_560105348.ag.pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,8,3]],"date-time":"2026-08-03T09:58:28Z","timestamp":1785751108000},"score":33.59972,"resource":{"primary":{"URL":"https:\/\/academic.oup.com\/edited-volume\/62568\/chapter\/560105348"}},"issued":{"date-parts":[[2026,4,9]]},"ISBN":["9780197852699"],"references-count":3,"URL":"https:\/\/doi.org\/10.1093\/9780197852699.003.0092","published":{"date-parts":[[2026,4,9]]}},{"indexed":{"date-parts":[[2026,5,28]],"date-time":"2026-05-28T01:07:41Z","timestamp":1779930461543,"version":"3.53.1"},"reference-count":0,"publisher":"University of Minnesota Press","isbn-type":[{"value":"9781452950068","type":"electronic"}],"content-domain":{"domain":[],"crossmark-restriction":false},"published-print":{"date-parts":[[2010,1,25]]},"DOI":"10.5749\/9781452950068-001","type":"book-chapter","created":{"date-parts":[[2026,5,28]],"date-time":"2026-05-28T00:38:06Z