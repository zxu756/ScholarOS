ype"},{"value":"\u00a9 2017 Elsevier Inc. All rights reserved.","name":"copyright","label":"Copyright"}]},{"indexed":{"date-parts":[[2026,10,23]],"date-time":"2026-10-23T21:18:06Z","timestamp":1792790286066,"version":"4.5.0"},"publisher":"Fundacao para a Ciencia e a Tecnologia (unidadeFCCN)","award-start":{"date-parts":[[2023,2,1]]},"award":"2022.13185.BD","DOI":"10.54499\/2022.13185.bd","type":"grant","created":{"date-parts":[[2025,5,26]],"date-time":"2025-05-26T05:37:31Z","timestamp":1748237851000},"source":"Crossref","prefix":"10.54499","member":"31773","project":[{"project-title":[{"title":"Prediction of high-grade glioma progression through quantitative multiparametric Magnetic Resonance Imaging","language":"en"},{"title":"Prediction of high-grade glioma progression through quantitative multiparametric Magnetic Resonance Imaging","language":"pt"}],"project-description":[{"description":"High-grade gliomas are the most common primary brain malignancy (80%), with an estimated 2-year survival rate of only 20%. Glioblastomas are particularly aggressive and malignant. Treatment inevitably requires surgical resection, trading-off maximum tissue removal around visible tumor to prolong survival and preservation of eloquent areas to maintain quality of life. \nAdvanced quantitative diffusion and perfusion magnetic resonance imaging can aid in tissue characterization, but non-invasive glioblastoma assessment remains challenging due to its highly infiltrative and heterogeneous properties.","language":"pt"}],"lead-investigator":[{"ORCID":"https:\/\/orcid.org\/0000-0002-2403-9626","authenticated-orcid":false,"given":"Catarina","family":"In\u00eas Rosa Passarinho","alternate-name":["Catarina In\u00eas Rosa Passarinho"],"affiliation":[]}],"award-amount":{"amount":79617.79,"currency":"EUR"},"award-start":{"date-parts":[[2023,2,1]]},"award-end":{"date-parts":[[2027,1,31]]},"funding":[{"type":"grant","scheme":"FCT","award-amount":{"amount":79617.79,"currency":"EUR","percentage":n