0Logis no 1 17\u201322. CDERAD \u00e9diteur Goudet."},{"key":"e_1_2_1_27_1","doi-asserted-by":"publisher","DOI":"10.1144\/sjg38010021"},{"key":"e_1_2_1_28_1","doi-asserted-by":"crossref","first-page":"241","DOI":"10.3176\/geol.2002.4.04","article-title":"Vegetation history and human impact in the Parika area, Central Estonia","volume":"51","author":"Niinemets E.","year":"2002","journal-title":"Proceedings of Estonian Academy of Sciences. Geology"},{"key":"e_1_2_1_29_1","first-page":"215","article-title":"Peat humification and climate history","volume":"71","author":"Nilssen E.","year":"1991","journal-title":"Norsk Geologisk Tidsskrift"},{"key":"e_1_2_1_30_1","first-page":"34","article-title":"Tephrochronological investigation of peat deposits in Scandinavia and on the Faroe Islands","volume":"656","author":"Persson C.","year":"1971","journal-title":"Geological Survey of Sweden"},{"key":"e_1_2_1_31_1","doi-asserted-by":"publisher","DOI":"10.1111\/j.1502-3885.2005.tb01011.x"},{"key":"e_1_2_1_32_1","doi-asserted-by":"publisher","DOI":"10.1177\/095968369200200307"},{"key":"e_1_2_1_33_1","doi-asserted-by":"publisher","DOI":"10.1177\/095968369600600112"},{"key":"e_1_2_1_34_1","doi-asserted-by":"publisher","DOI":"10.1177\/095968369500500111"},{"key":"e_1_2_1_35_1","doi-asserted-by":"publisher","DOI":"10.1007\/978-1-4899-2617-3_4"},{"key":"e_1_2_1_36_1","first-page":"87","article-title":"The Hekla ashfalls in Finland","volume":"21","author":"Salmi M.","year":"1948","journal-title":"Suomen Geologinen Seura"},{"key":"e_1_2_1_37_1","doi-asserted-by":"publisher","DOI":"10.1017\/S0033822200019123"},{"key":"e_1_2_1_38_1","doi-asserted-by":"publisher","DOI":"10.1002\/(SICI)1099-1417(199711\/12)12:6<525::AID-JQS347>3.0.CO;2-M"},{"key":"e_1_2_1_39_1","doi-asserted-by":"publisher","DOI":"10.1002\/jqs.822"},{"key":"e_1_2_1_40_1","first-page":"119","article-title":"Vegetation history, human impact and palaeogeography of west Estonia. Pollen analytical studies of lake and bog sediments"