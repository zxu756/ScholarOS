00-9483","type":"print"},{"value":"1502-3885","type":"electronic"}],"published":{"date-parts":[[2006,11]]}},{"indexed":{"date-parts":[[2025,5,14]],"date-time":"2025-05-14T04:54:47Z","timestamp":1747198487515,"version":"3.40.5"},"description":"x-ray diffraction structure","reference-count":0,"publisher":"Worldwide Protein Data Bank","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.2210\/pdb8ttr\/pdb","type":"component","created":{"date-parts":[[2023,8,22]],"date-time":"2023-08-22T18:15:45Z","timestamp":1692728145000},"source":"Crossref","is-referenced-by-count":0,"title":["CA9 mimic bound to SH7"],"prefix":"10.2210","author":[{"given":"T.S.","family":"Peat","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"7763","published-online":{"date-parts":[[2024,11,27]]},"deposited":{"date-parts":[[2024,12,10]],"date-time":"2024-12-10T19:33:42Z","timestamp":1733859222000},"score":23.59772,"resource":{"primary":{"URL":"https:\/\/www.wwpdb.org\/pdb?id=pdb_00008ttr"}},"issued":{"date-parts":[[2024,11,27]]},"references-count":0,"URL":"https:\/\/doi.org\/10.2210\/pdb8ttr\/pdb","published":{"date-parts":[[2024,11,27]]}},{"indexed":{"date-parts":[[2025,10,26]],"date-time":"2025-10-26T12:39:52Z","timestamp":1761482392651,"version":"build-2065373602"},"reference-count":63,"publisher":"Wiley","issue":"5","license":[{"start":{"date-parts":[[2014,9,9]],"date-time":"2014-09-09T00:00:00Z","timestamp":1410220800000},"content-version":"vor","delay-in-days":8,"URL":"http:\/\/onlinelibrary.wiley.com\/termsAndConditions#vor"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["Soil Horizons"],"published-print":{"date-parts":[[2014,9]]},"abstract":"<jats:p>\n                    For millennia, humans have impacted soil formation and altered soil properties. Wetlands were extensively drained in the United States during the last 200 years for agricultural purposes, which affected the environment, passively. Thus, this study focused on assessment of soil C (organic and inorganic) and Si pools across a drained catena encompassing all landscape positions. Soil samples were collected from all landscape positions and analyzed for physical and chemical properties. Soil bulk density of the surface horizons decreased downslope from 1.65 Mg m\n                    <jats:sup>\u20133<\/jats:sup>\n                    at the summit to 1.44 Mg m\n                    <jats:sup>\u20133<\/jats:sup>\n                    at the toeslope. At the lowland, the artificial internal drainage caused a substantial loss of soil organic carbon (SOC) and converted the Histosol (\n                    <jats:ext-link xmlns:xlink=\"http:\/\/www.w3.org\/1999\/xlink\" xlink:href=\"https:\/\/soilseries.sc.egov.usda.gov\/OSD_Docs\/C\/CARLISLE.html\">Carlisle<\/jats:ext-link>\n                    series) to a Mollisol (\n                    <jats:ext-link xmlns:xlink=\"http:\/\/www.w3.org\/1999\/xlink\" xlink:href=\"https:\/\/soilseries.sc.egov.usda.gov\/OSD_Docs\/K\/KOKOMO.html\">Kokomo<\/jats:ext-link>\n                    series). Soil total carbon (STC) of the surface horizons increased downslope from 1.24% at the summit to 4.6% at the toeslope. Soil organic carbon followed the same trend as that of STC across the landscape. Soil inorganic carbon (SIC) occurred in the lower horizons of the summit and shoulder (\u223c4%) and in the surface horizon of the toeslope (0.1%). Amorphous Si (ASi) and plant available Si (PASi) concentrations generally increased downslope across the soil catena and increased downward within pedons. Concentration of ASi increased from 312 to 341 mg kg\n                    <jats:sup>\u20131<\/jats:sup>\n                    , and PASi increased from 56 to 94 mg kg\n                    <jats:sup>\u20131<\/jats:sup>\n                    for the surface horizons at the summit and toeslope, respectively. Soil pH ranged from 6.6 to 7.5 for the surface horizons at the footslope and shoulder positions, respectively.\n                  <\/jats:p>","DOI":"10.2136\/sh14-04-0004","type":"journal-article","created":{"date-parts":[[2014,9,9]],"date-time":"2014-09-09T11:50:26Z","timestamp":1410263426000},"page":"1-8","source":"Crossref","is-referenced-by-count":1,"title":["Soil Carbon and Silicon Pools across a Drained Catena in Central Ohio, USA"],"prefix":"10.2136","volume":"55","author":[{"given":"M. A.","family":"Ibrahim","sequence":"first","affiliation":[{"name":"Soil Science Dep. College of Agriculture Zagazig Univ. Zagazig Egypt"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"R.","family":"Lal","sequence":"additional","affiliation":[{"name":"Carbon Management &amp; Sequestration Center School of Environment &amp; Natural Resources The Ohio State Univ. Columbus OH 43210"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"311","published-online":{"date-parts":[[2014,9,9]]},"reference":[{"key":"e_1_2_7_2_1","doi-asserted-by":"publisher","DOI":"10.1016\/j.geoderma.2012.10.020"},{"key":"e_1_2_7_3_1","doi-asserted-by":"publisher","DOI":"10.1007\/s11104-011-0902-z"},{"key":"e_1_2_7_4_1","doi-asserted-by":"crossref","DOI":"10.2136\/sh12-04-0012","article-title":"Soils and climate change: Gas fluxes and soil processes","volume":"53","author":"Brevik E.C.","year":"2012","journal-title":"Soil Horiz."},{"key":"e_1_2_7_5_1","doi-asserted-by":"crossref","DOI":"10.2136\/sh12-03-0011","article-title":"Long\u2010term effects of compaction on soil properties along the Mormon Trail, south\u2010central Iowa, USA","volume":"53","author":"Brevik E.C.","year":"2012","journal-title":"Soil Horiz."},{"key":"e_1_2_7_6_1","doi-asserted-by":"publisher","DOI":"10.1016\/j.catena.2003.12.001"},{"key":"e_1_2_7_7_1","doi-asserted-by":"publisher","DOI":"10.2136\/sssaj1987.03615995005100060025x"},{"key":"e_1_2_7_8_1","doi-asserted-by":"publisher","DOI":"10.1016\/0012-821X(84)90089-X"},{"key":"e_1_2_7_9_1","doi-asserted-by":"publisher","DOI":"1