13\/acdfca","volume":"951","author":"Harsono","year":"2023","journal-title":"ApJ"},{"key":"R41","doi-asserted-by":"crossref","first-page":"135","DOI":"10.1146\/annurev-astro-081915-023347","volume":"54","author":"Hartmann","year":"2016","journal-title":"ARA&A"},{"key":"R42","doi-asserted-by":"crossref","first-page":"2403","DOI":"10.1086\/117974","volume":"111","author":"Herbst","year":"1996","journal-title":"AJ"},{"key":"R43","doi-asserted-by":"crossref","first-page":"58","DOI":"10.1088\/0004-637X\/717\/1\/58","volume":"717","author":"Hirano","year":"2010","journal-title":"ApJ"},{"key":"R44","doi-asserted-by":"crossref","first-page":"1203","DOI":"10.1088\/0004-637X\/703\/2\/1203","volume":"703","author":"Hollenbach","year":"2009","journal-title":"ApJ"},{"key":"R45","doi-asserted-by":"crossref","first-page":"306","DOI":"10.1086\/167595","volume":"342","author":"Hollenbach","year":"1989","journal-title":"ApJ"},{"key":"R46","doi-asserted-by":"crossref","first-page":"90","DOI":"10.1109\/MCSE.2007.55","volume":"9","author":"Hunter","year":"2007","journal-title":"Comput. Sci. Eng."},{"key":"R47","doi-asserted-by":"crossref","first-page":"2519","DOI":"10.1093\/mnras\/stad1391","volume":"523","author":"Jones","year":"2023","journal-title":"MNRAS"},{"key":"R48","doi-asserted-by":"crossref","first-page":"908","DOI":"10.1051\/0004-6361:20020681","volume":"389","author":"J\u00f8rgensen","year":"2002","journal-title":"A&A"},{"key":"R49","doi-asserted-by":"crossref","first-page":"283","DOI":"10.1086\/503596","volume":"644","author":"Kaufman","year":"2006","journal-title":"ApJ"},{"key":"R50","doi-asserted-by":"crossref","first-page":"254","DOI":"10.1051\/0004-6361:20010936","volume":"376","author":"Keane","year":"2001","journal-title":"A&A"},{"key":"R51","doi-asserted-by":"crossref","first-page":"110","DOI":"10.3847\/1538-3881\/ac0632","volume":"162","author":"Krolikowski","year":"2021","journal-title":"AJ"},{"key":"R52","doi-asserted-by":"crossref","first-page":"272","DOI":"10.11