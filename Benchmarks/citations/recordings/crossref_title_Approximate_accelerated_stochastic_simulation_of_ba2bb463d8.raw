e":"J. Chem. Phys."},{"issue":"1","key":"10.1016\/j.jcp.2004.12.014_bib18","doi-asserted-by":"crossref","first-page":"014116","DOI":"10.1063\/1.1824902","article-title":"The slow-scale stochastic simulation algorithm","volume":"122","author":"Cao","year":"2005","journal-title":"J. Chem. Phys."},{"key":"10.1016\/j.jcp.2004.12.014_bib19","series-title":"Handbook of Stochastic Methods, for Physics, Chemistry and the Natual Sciences","author":"Gardiner","year":"2003"},{"key":"10.1016\/j.jcp.2004.12.014_bib20","doi-asserted-by":"crossref","DOI":"10.1073\/pnas.79.4.1129","article-title":"Quantitative model for gene regulation by a lambda phage repressor","author":"Ackers","year":"1982","journal-title":"Proc. Natl. Acad. Sci. USA"},{"key":"10.1016\/j.jcp.2004.12.014_bib21","doi-asserted-by":"crossref","DOI":"10.1016\/0022-2836(85)90086-5","article-title":"The or control system of bacteriophage lambda","author":"Shea","year":"1985","journal-title":"J. Mol. Biol."},{"key":"10.1016\/j.jcp.2004.12.014_bib22","series-title":"Mathematics Applied to Deterministic Problems in the Natural Sciences","author":"Lin","year":"1988"},{"key":"10.1016\/j.jcp.2004.12.014_bib23","series-title":"Mathematical Biology","author":"Murray","year":"1993"}],"container-title":["Journal of Computational Physics"],"language":"en","link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0021999104005182?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0021999104005182?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}],"deposited":{"date-parts":[[2021,7,4]],"date-time":"2021-07-04T23:04:10Z","timestamp":1625439850000},"score":43.378105,"resource":{"primary":{"URL":"https:\/\/linkinghub.elsevier.com\/retrieve\/pii\/S0021999104005182"}},"issued":{"date-parts":[[2005,7]]},"references-count":23,"journal-issue":{"iss