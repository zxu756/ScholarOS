journal-title":"Biotechniques"},{"issue":"23","key":"pcbi.1010956.ref046","doi-asserted-by":"crossref","first-page":"7159","DOI":"10.1073\/pnas.1422285112","article-title":"Dissecting enzyme function with microfluidic-based deep mutational scanning","volume":"112","author":"PA Romero","year":"2015","journal-title":"Proceedings of the National Academy of Sciences"},{"issue":"7","key":"pcbi.1010956.ref047","doi-asserted-by":"crossref","first-page":"e6441","DOI":"10.1371\/journal.pone.0006441","article-title":"Circular polymerase extension cloning of complex gene libraries and pathways","volume":"4","author":"J Quan","year":"2009","journal-title":"PloS one"},{"issue":"21","key":"pcbi.1010956.ref048","doi-asserted-by":"crossref","first-page":"2957","DOI":"10.1093\/bioinformatics\/btr507","article-title":"FLASH: fast length adjustment of short reads to improve genome assemblies","volume":"27","author":"T Mago\u010d","year":"2011","journal-title":"Bioinformatics"},{"issue":"4","key":"pcbi.1010956.ref049","doi-asserted-by":"crossref","first-page":"357","DOI":"10.1038\/nmeth.1923","article-title":"Fast gapped-read alignment with Bowtie 2","volume":"9","author":"B Langmead","year":"2012","journal-title":"Nature methods"}],"updated-by":[{"DOI":"10.1371\/journal.pcbi.1010956","type":"new_version","label":"New version","source":"publisher","updated":{"date-parts":[[2023,3,13]],"date-time":"2023-03-13T00:00:00Z","timestamp":1678665600000}}],"container-title":["PLOS Computational Biology"],"language":"en","link":[{"URL":"https:\/\/dx.plos.org\/10.1371\/journal.pcbi.1010956","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2023,3,13]],"date-time":"2023-03-13T13:41:06Z","timestamp":1678714866000},"score":31.295265,"resource":{"primary":{"URL":"https:\/\/dx.plos.org\/10.1371\/journal.pcbi.1010956"}},"editor":[{"given":"Jinyan","family":"Li","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"editor"}]}],"issued":{"date-parts":[[2023,3,1]]},"references-count":49,"journal-issue":{"issue":"3","published-online":{"date-parts":[[2023,3,1]]}},"URL":"https:\/\/doi.org\/10.1371\/journal.pcbi.1010956","relation":{"has-preprint":[{"id-type":"doi","id":"10.1101\/2022.09.01.506224","asserted-by":"object"}]},"ISSN":["1553-7358"],"issn-type":[{"value":"1553-7358","type":"electronic"}],"published":{"date-parts":[[2023,3,1]]}},{"institution":[{"name":"bioRxiv"}],"indexed":{"date-parts":[[2026,1,15]],"date-time":"2026-01-15T18:53:32Z","timestamp":1768503212182,"version":"3.49.0"},"posted":{"date-parts":[[2022,9,2]]},"group-title":"Bioinformatics","reference-count":42,"publisher":"openRxiv","content-domain":{"domain":[],"crossmark-restriction":false},"accepted":{"date-parts":[[2022,9,2]]},"abstract":"<jats:title>ABSTRACT<\/jats:title>\n                <jats:p>\n                  Directed laboratory evolution applies iterative rounds of mutation and selection to explore the protein fitness landscape and provides rich information regarding the underlying relationships between protein sequence, structure, and function. Laboratory evolution data consist of protein sequences sampled from evolving populations over multiple generations and this data type does not fit into established supervised and unsupervised machine learning approaches. We develop a statistical learning framework that models the evolutionary process and can infer the protein fitness landscape from multiple snapshots along an evolutionary trajectory. We apply our modeling approach to dihydrofolate reductase (DHFR) laboratory evolution data and the resulting landscape parameters capture important aspects of DHFR structure and function. We use the resulting model to understand the structure of the fitness landscape and find numerous examples of epistasis but an overall global peak that is evolutionarily accessible from most starting sequences. Finally, we use the model to perform an\n                  <jats:italic>in silico<\/jats:italic>\n                  extrapolation of the DHFR laboratory evolution trajectory and computationally design proteins from future evolutionary rounds.\n                <\/jats:p>","DOI":"10.1101\/2022.09.01.506224","type":"posted-content","created":{"date-parts":[[2022,9,2]],"date-time":"2022-09-02T11:30:27Z","timestamp":1662118227000},"source":"Crossref","is-referenced-by-count":0,"title":["Inferring protein fitness landscapes from laboratory evolution experiments"],"prefix":"10.64898","author":[{"given":"Sameer","family":"D\u2019Costa","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Emily C.","family":"Hinds","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-2208-1660","authenticated-orcid":false,"given":"Chase R.","family":"Freschlin","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-1875-5009","authenticated-orcid":false,"given":"Hyebin","family":"Song","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-2586-7263","authenticated-orcid":false,"given":"Philip A.","family":"Romero","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"54368","reference":[{"key":"2022090512450616000_2022.09.01.506224v1.1","doi-asserted-by":"publisher","DOI":"10.1038\/s41592-019-0496-6"},{"key":"2022090512450616000_2022.09.01.506224v1.2","doi-asserted-by":"crossref","first-page":"327","DOI":"10.1021\/acsmacrolett.0c00885","article-title":"100th anniversary of macromolecular science Viewpoint: Data-driven protein design","volume":"10","year":"2021","journal-title":"ACS Macro Lett."},{"key":"2022090512450616000_2022.09.01.506224v1.3","doi-asserted-by":"crossref","first-page":"654","DOI":"10.1016\/j.cels.2021.05.017","article-title":"Learning the protein language: Evolution, structure, and function","volume":"12","year":"2021","journal-title":"Cell Syst."},{"key":"2022090512450616000_2022.09.01.506224v1.4","doi-asserted-by":"crossref","first-page":"102713","DOI":"10.1016\/j.copbio.2022.102713","article-title":"Machine learning to navigate fitness landscapes for protein engineering","volume":"75","year":"2022","journal-title":"Curr. Opin. Biotechnol."},{"key":"2022090512450616000_2022.09.01.506224v1.5","doi-asserted-by":"crossref","first-page":"1313","DOI":"10.1021\/acssynbio.1c00592","article-title":"EvSeq: Cost-effective amplicon sequencing of every variant in a protein library","volume":"11","year":"2022","journal-title":"ACS Synth. Biol."},{"key":"2022090512450616000_2022.09.01.506224v1.6","doi-asserted-by":"publisher","DOI":"10.1038\/nmeth.3027"},{"key":"2022090512450616000_2022.09.01.506224v1.7","doi-asserted-by":"publisher","DOI":"10.1038\/nrm2805"},{"key":"2022090512450616000_2022.09.01.506224v1.8","doi-asserted-by":"publisher","DOI":"10.1038\/s41592-021-01100-y"},{"key":"2022090512450616000_2022.09.01.506224v1.9","doi-asserted-by":"crossref","first-page":"1114","DOI":"10.1038\/s41587-021-01146-5","article-title":"Learning protein fitness models from evolutionary and assay-labeled data","volume":"40","year":"2022","journal-title":"Nat. Biotechnol."},{"key":"2022090512450616000_2022.09.01.506224v1.10","doi-asserted-by":"publisher","DOI":"10.1073\/pnas.2104878118"},{"key":"2022090512450616000_2022.09.01.506224v1.11","doi-asserted-by":"publisher","DOI":"10.1073\/pnas.2016239118"},{"key":"2022090512450616000_2022.09.01.506224v1.12","doi-asserted-by":"crossref","first-page":"5800","DOI":"10.1038\/s41467-021-25756-4","article-title":"Efficient generative modeling of protein sequences using simple autoregressive models","volume":"12","year":"2021","journal-title":"Nat. Commun."},{"key":"2022090512450616000_2022.09.01.506224v1.13","doi-asserted-by":"crossref","first-pa