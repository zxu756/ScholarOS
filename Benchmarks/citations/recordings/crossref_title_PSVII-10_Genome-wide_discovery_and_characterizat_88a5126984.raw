e":"5","key":"key\n\t\t\t\t20170905061427_evx145-B34","doi-asserted-by":"crossref","first-page":"569","DOI":"10.1266\/jjg.66.569","article-title":"Diversification of the rice Waxy gene by insertion of mobile DNA elements into introns","volume":"66","year":"1991","journal-title":"Jpn J Genet."},{"issue":"Database issue","key":"key\n\t\t\t\t20170905061427_evx145-B35","first-page":"D83","article-title":"SINEBase: a database and tool for SINE analysis","volume":"41","year":"2013","journal-title":"Nucleic Acids Res."},{"issue":"47","key":"key\n\t\t\t\t20170905061427_evx145-B36","doi-asserted-by":"crossref","first-page":"17638","DOI":"10.1073\/pnas.0605618103","article-title":"Analysis of retrotransposon structural diversity uncovers properties and propensities in angiosperm genome evolution","volume":"103","year":"2006","journal-title":"Proc Natl Acad Sci U S A."},{"issue":"12","key":"key\n\t\t\t\t20170905061427_evx145-B37","doi-asserted-by":"crossref","first-page":"e1004843","DOI":"10.1371\/journal.pgen.1004843","article-title":"Recurrent loss of specific introns during angiosperm evolution","volume":"10","year":"2014","journal-title":"PLoS Genet."},{"issue":"9","key":"key\n\t\t\t\t20170905061427_evx145-B38","doi-asserted-by":"crossref","first-page":"3117","DOI":"10.1105\/tpc.111.088682","article-title":"Targeted identification of short interspersed nuclear element families shows their widespread existence and extreme heterogeneity in plant genomes","volume":"23","year":"2011","journal-title":"Plant Cell"},{"issue":"12","key":"key\n\t\t\t\t20170905061427_evx145-B39","doi-asserted-by":"crossref","first-page":"973","DOI":"10.1038\/nrg2165","article-title":"A unified classification system for eukaryotic transposable elements","volume":"8","year":"2007","journal-title":"Nat Rev Genet."},{"issue":"1","key":"key\n\t\t\t\t20170905061427_evx145-B40","doi-asserted-by":"crossref","first-page":"19","DOI":"10.1266\/ggs.86.19","article-title":"A novel Au SINE sequence found in a gymnosperm","volume":"86","year":"2011","journal-title":"Genes Genet Syst."},{"issue":"47","key":"key\n\t\t\t\t20170905061427_evx145-B41","doi-asserted-by":"crossref","first-page":"19922","DOI":"10.1073\/pnas.0908008106","article-title":"Distribution, diversity, evolution, and survival of Helitrons in the maize genome","volume":"106","year":"2009","journal-title":"Proc Natl Acad Sci U S A."},{"issue":"4","key":"key\n\t\t\t\t20170905061427_evx145-B42","doi-asserted-by":"crossref","first-page":"463","DOI":"10.1007\/s001220051668","article-title":"The Au family, a novel short interspersed element (SINE) from Aegilops umbellulata","volume":"102","year":"2001","journal-title":"Theor Appl Genet."},{"issue":"14","key":"key\n\t\t\t\t20170905061427_evx145-B43","doi-asserted-by":"crossref","first-page":"6562","DOI":"10.1073\/pnas.90.14.6562","article-title":"Molecular characterization of a short interspersed repetitive element from tobacco that exhibits sequence homology to specific tRNAs","volume":"90","year":"1993","journal-title":"Proc Natl Acad Sci U S A."},{"issue":"4","key":"key\n\t\t\t\t20170905061427_evx145-B44","doi-asserted-by":"crossref","first-page":"923","DOI":"10.1111\/j.1469-8137.2012.04212.x","article-title":"Highly conserved low-copy nuclear genes as effective markers for phylogenetic analyses in angiosperms","volume":"195","year":"2012","journal-title":"New Phytol."}],"container-title":["Genome Biology and Evolution"],"language":"en","link":[{"URL":"http:\/\/academic.oup.com\/gbe\/article-pdf\/9\/8\/2048\/19690997\/evx145.pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2023,8,24]],"date-time":"2023-08-24T20:03:06Z","timestamp":1692907386000},"score":56.067394,"resource":{"primary":{"URL":"http:\/\/academic.oup.com\/gbe\/article\/9\/8\/2048\/4083511\/Distribution-Diversity-and-LongTerm-Retention-of"}},"issued":{"date-parts":[[2017,8]]},"references-count":44,"journal-issue":{"issue":"8","published-online":{"date-parts":[[2017,8,17]]},"published-print":{"date-parts":[[2017,8]]}},"URL":"https:\/\/doi.org\/10.1093\/gbe\/evx145","ISSN":["1759-6653"],"issn-type":[{"value":"1759-6653","type":"electronic"}],"published":{"date-parts":[[2017,8]]}},{"indexed":{"date-parts":[[2026,11,14]],"date-time":"2026-11-14T11:21:13Z","timestamp":1794655273144,"version":"4.9.1"},"reference-count":62,"publisher":"Cold Spring Harbor Laboratory","issue":"12","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["Genome Res."],"published-print":{"date-parts":[[2005,12]]},"abstract":"<jats:p>SINEs are retrotransposons that have enjoyed remarkable reproductive success during the course of mammalian evolution, and have played a major role in shaping mammalian genomes. Previously, an analysis of survey-sequence data from an individual dog (a poodle) indicated that canine genomes harbor a high frequency of alleles that differ only by the absence or presence of a SINEC_Cf repeat. Comparison of this survey-sequence data with a draft genome sequence of a distinct dog (a boxer) has confirmed this prediction, and revealed the chromosomal coordinates for &gt;10,000 loci that are bimorphic for SINEC_Cf insertions. Analysis of SINE insertion sites from the genomes of nine additional dogs indicates that 3%-5% are absent from either the poodle or boxer genome sequences\u2014suggesting that an additional 10,000 bimorphic loci could be readily identified in the general dog population. We describe a methodology that can be used to identify these loci, and could be adapted to exploit these bimorphic loci for genotyping purposes. Approximately half of all annotated canine genes contain SINEC_Cf repeats, and these elements are occasionally transcribed. When transcribed in the antisense orientation, they provide splice acceptor sites that can result in incorporation of novel exons. The high frequency of bimorphic SINE insertions in the dog population is predicted to provide numerous examples of allele-specific transcription patterns that will be valuable for the study of differential gene expression among multiple dog breeds.<\/jats:p>","DOI":"10.1101\/gr.3765505","type":"journal-article","created":{"date-parts":[[2005,12,8]],"date-time":"2005-12-08T19:03:03Z","timestamp":1134068583000},"page":"1798-1808","source":"Crossref","is-referenced-by-count":128,"title":["Short interspersed elements (SINEs) are a major source of canine genomic diversity"],"prefix":"10.1101","volume":"15","author":[{"given":"Wei","family":"Wang","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Ewen F.","family":"Kirkness","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"246","published-online":{"date-parts":[[2005,12,8]]},"reference":[{"key":"2021111811011293000_15.12.1798.1","doi-asserted-by":"publisher","DOI":"10.1086\/378594"},{"key":"2021111811011293000_15.12.1798.2","doi-asserted-by":"publisher","DOI":"10.1038\/nrg798"},{"key":"2021111811011293000_15.12.1798.3","doi-asserted-by":"publisher","DOI":"10.1007\/s003359901074"},{"key":"2021111811011293000_15.12.1798.4","doi-asserted-by":"publisher","DOI":"10.1007\/s003350020029"},{"key":"2021111811011293000_15.12.1798.5","doi-asserted-by":"publisher","DOI":"10.1073\/pnas.89.22.10706"},{"key":"2021111811011293000_15.12.1798.6","doi-asserted-by":"crossref","first-page":"769","DOI":"10.1093\/genetics\/158.2.769","volume":"158","year":"2001","journal-title":"Genetics"},{"key":"2021111811011293000_15.12.1798.7","doi-asserted-by":"publisher","DOI":"10.1007\/s00439-003-0991-8"},{"key":"2021111811011293000_15.12.1798.8","doi-asserted-by":"publisher","DOI":"10.1006\/mgme.1999.2864"},{"key":"2021111811011293000_15.12.1798.9","doi-asserted-by":"publisher","DOI":"10.1038\/ng1223"},{"key":"2021111811011293000_15.12.1798.10","first-page":"430","volume":"4","year":"1992","journal-title":"New Biol."},{"key":"