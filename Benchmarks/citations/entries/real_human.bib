@article{real_human_060,
   abstract = {In order to understand the nature of friction in dense granular materials, a discrete element simulation on granular layers subjected to isobaric plain shear is performed. It is found that the friction coefficient increases as the power of the shear rate, the exponent of which does not depend on the material constants. Using a nondimensional parameter that is known as the inertial number, the power law can be cast in a generalized form so that the friction coefficients at different confining pressures collapse on the same curve. We show that the volume fraction also obeys a power law. © 2007 The American Physical Society.},
   author = {Takahiro Hatano},
   doi = {10.1103/PhysRevE.75.060301},
   issn = {1539-3755},
   issue = {6},
   journal = {Phys. Rev. E},
   month = {6},
   pages = {060301},
   title = {Power-law friction in closely packed granular materials},
   volume = {75},
   url = {https://link.aps.org/doi/10.1103/PhysRevE.75.060301},
   year = {2007},
}

@article{real_human_061,
   abstract = {The dynamics of microtubules (MTâ€™s) growing from a nucleation center is simulated with a kinetic Monte Carlo model that includes tubulin diffusion. In the limit of fast diffusion (homogeneous tubulin concentration), MT growth is synchronous and bounded. The microtubules form an aster with a monotonously decreasing long-time distribution of lengths. Slow tubulin diffusion leads to rapid dephasing in the growth dynamics, unbounded growth of some MTâ€™s, spatial inhomogeneities, and morphological change toward a morphology with bounded short MTâ€ ™s located in the nucleation center and unbounded long MTâ€™s with narrowly distributed lengths. The transition from unbounded to bounded growth is driven by the competition between the reaction rate of the tubulin assembly and the tubulinâ€™s diffusion rate. While the present study reports the effect of the tubulin diffusion coefficient on the transition, the results of the simulations are qualitatively comparable to the morphological and dynamical changes of centrosome-nucleated MTâ€™s from interphase to mitosis in cellular systems where the transition is regulated by the reaction rates. © 2005 The American Physical Society.},
   author = {P. A. Deymier and Y. Yang and J. Hoying},
   doi = {10.1103/PhysRevE.72.021906},
   issn = {15393755},
   issue = {2},
   journal = {Physical Review E - Statistical, Nonlinear, and Soft Matter Physics},
   month = {8},
   pmid = {16196603},
   title = {Effect of tubulin diffusion on polymerization of microtubules},
   volume = {72},
   year = {2005},
}

